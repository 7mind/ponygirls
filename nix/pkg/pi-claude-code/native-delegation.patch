new file mode 100644
index 0000000..1de5274
--- /dev/null
+++ b/tests/native-lifecycle.test.ts
@@ -0,0 +1,40 @@
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { once } from "node:events";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+import { captureProcess, killProcessTree } from "../src/claude-cli.ts";
+
+async function running(pid: number): Promise<boolean> {
+  try { return (await readFile(`/proc/${pid}/stat`, "utf8")).split(") ")[1]!.charAt(0) !== "Z"; }
+  catch (e) { if ((e as NodeJS.ErrnoException).code === "ENOENT") return false; throw e; }
+}
+
+test("completed acquisition commands do not leave owned descendants running", { skip: process.platform !== "linux" }, async () => {
+  let pid = 0;
+  try {
+    const result = await captureProcess(process.execPath, ["-e", `const {spawn}=require('node:child_process');const c=spawn(process.execPath,['-e','setInterval(()=>{},1000)'],{stdio:'ignore'});c.once('spawn',()=>{console.log(String(c.pid));c.unref()})`], {}, undefined, 2000);
+    pid = Number(result.stdout.trim());
+    assert.ok(pid > 0, result.stderr);
+    assert.equal(await running(pid), false);
+  } finally { if (pid > 0) { try { process.kill(pid, "SIGKILL"); } catch {} } }
+});
+
+test("detached CLI descendants are stopped after the leader has exited", { skip: process.platform !== "linux" }, async () => {
+  const leader = spawn(process.execPath, ["-e", `const {spawn}=require('node:child_process');const c=spawn(process.execPath,['-e','setInterval(()=>{},1000)'],{stdio:'ignore'});c.once('spawn',()=>{console.log(String(c.pid));c.unref()});c.once('error',e=>{console.error(e);process.exitCode=1})`], { detached: true, stdio: ["ignore", "pipe", "pipe"] });
+  let output = "";
+  let stderr = "";
+  leader.stderr!.on("data", (data: Buffer) => { stderr += data.toString(); });
+  leader.stdout!.on("data", (data: Buffer) => { output += data.toString(); });
+  await once(leader, "close");
+  const pid = Number(output.trim());
+  assert.equal(leader.exitCode, 0, stderr);
+  assert.ok(pid > 0, JSON.stringify({ output, stderr, executable: process.execPath }));
+  try {
+    assert.equal(await running(pid), true);
+    killProcessTree(leader);
+    const deadline = Date.now() + 2000;
+    while (await running(pid) && Date.now() < deadline) await new Promise((resolve) => setTimeout(resolve, 10));
+    assert.equal(await running(pid), false);
+  } finally { try { process.kill(-leader.pid!, "SIGKILL"); } catch {} }
+});
diff --git a/tests/native-owner.test.ts b/tests/native-owner.test.ts
new file mode 100644
index 0000000..da4dcef
--- /dev/null
+++ b/tests/native-owner.test.ts
@@ -0,0 +1,90 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { NativeSessions, NATIVE_NAMESPACE } from "../src/native-delegation.ts";
+
+function delegation(sessions: NativeSessions, id: string) {
+  return sessions.enter({ metadata: { [NATIVE_NAMESPACE]: { capability: sessions.capability, cwd: process.cwd(), lifecycleSessionId: id, beforeEntry: () => {}, captureOriginal: (stream) => stream } } })!;
+}
+
+test("native lifecycle retires synchronously, closes every owned process and joins pending acquisition", async () => {
+  const sessions = new NativeSessions("fixture");
+  const worker = delegation(sessions, "worker");
+  const reviewer = delegation(sessions, "reviewer");
+  let release!: () => void;
+  const pending = worker.track(new Promise<void>((resolve) => { release = resolve; }));
+  const closed: number[] = [];
+  for (const id of [1, 2, 3]) {
+    const process = { close: async () => { closed.push(id); worker.release(process); } };
+    worker.own(process);
+  }
+  let disposed = false;
+  const disposal = sessions.capability.disposeSession("worker").then(() => { disposed = true; });
+  assert.equal(worker.signal.aborted, true);
+  assert.throws(() => worker.beforeEntry(), /retired/);
+  assert.equal(reviewer.signal.aborted, false);
+  await new Promise((resolve) => setImmediate(resolve));
+  assert.deepEqual(closed.sort(), [1, 2, 3]);
+  assert.equal(disposed, false);
+  release();
+  await pending;
+  await disposal;
+  assert.equal(disposed, true);
+  await sessions.capability.disposeSession("reviewer");
+});
+
+test("synchronous owned close failure does not skip other closes or pending acquisition joins", async () => {
+  const sessions = new NativeSessions("fixture");
+  const owner = delegation(sessions, "synchronous-failure");
+  const closed: string[] = [];
+  const failure = new Error("controlled synchronous EPERM");
+  owner.own({ close: () => { closed.push("first"); throw failure; } });
+  const second = { close: async () => { closed.push("second"); owner.release(second); } };
+  owner.own(second);
+  let release!: () => void;
+  const acquired = { close: async () => { closed.push("acquired"); owner.release(acquired); } };
+  const pending = owner.track(new Promise<void>((resolve) => { release = () => { owner.own(acquired); resolve(); }; }));
+  let settled = false;
+  const disposal = sessions.capability.disposeSession("synchronous-failure").then(() => { settled = true; return null; }, (error: unknown) => { settled = true; return error; });
+  try {
+    await new Promise((resolve) => setImmediate(resolve));
+    assert.deepEqual(closed, ["first", "second"]);
+    assert.equal(settled, false);
+    release();
+    await pending;
+    const outcome = await disposal;
+    assert.ok(outcome instanceof AggregateError);
+    assert.ok(outcome.errors.includes(failure));
+    assert.deepEqual(closed, ["first", "second", "acquired"]);
+  } finally { release(); await pending; await disposal; }
+});
+
+test("pending acquisition rejection is included in native cleanup failure", async () => {
+  const sessions = new NativeSessions("fixture");
+  const owner = delegation(sessions, "pending-failure");
+  let reject!: (error: Error) => void;
+  const failure = new Error("controlled pending cleanup failure");
+  const pending = owner.track(new Promise<void>((_resolve, fail) => { reject = fail; }));
+  void pending.catch(() => {});
+  const disposal = sessions.capability.disposeSession("pending-failure");
+  void disposal.catch(() => {});
+  await new Promise((resolve) => setImmediate(resolve));
+  reject(failure);
+  await assert.rejects(disposal, (error: unknown) => error instanceof AggregateError && error.errors.includes(failure));
+});
+
+test("native lifecycle cleanup failures propagate rather than establishing stopped state", async () => {
+  const sessions = new NativeSessions("fixture");
+  const request = delegation(sessions, "failed");
+  request.own({ close: async () => { throw new Error("termination not observed"); } });
+  await assert.rejects(sessions.capability.disposeSession("failed"), /Native delegation cleanup failed/);
+  assert.throws(() => request.beforeEntry(), /retired/);
+});
+
+test("native lifecycle retains acquisition cleanup faults after request completion", async () => {
+  const sessions = new NativeSessions("fixture");
+  const request = delegation(sessions, "acquisition");
+  request.cleanupFailed(new Error("acquisition descendant still running"));
+  assert.equal(request.signal.aborted, true);
+  assert.throws(() => request.beforeEntry(), /retired/);
+  await assert.rejects(sessions.capability.disposeSession("acquisition"), /Native delegation cleanup failed/);
+});
