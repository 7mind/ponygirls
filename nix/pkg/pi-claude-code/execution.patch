+++ b/src/execution.ts
@@ -0,0 +1,32 @@
+import { isAbsolute } from "node:path";
+import type { AssistantMessageEventStream, SimpleStreamOptions } from "@earendil-works/pi-ai";
+import type { RunClaudeInput, RunClaudeOutput } from "./claude-cli.ts";
+
+export const EXECUTION_NAMESPACE = "pi-claude-code.execution.v1";
+export const EXECUTION_SYMBOL = Symbol.for(EXECUTION_NAMESPACE);
+export const EXECUTION_PROFILE = "canonical-simple-no-provider-hooks-v1";
+
+export interface ClaudeExecutionCapability {
+  readonly version: 1;
+  readonly apis: readonly string[];
+  readonly requestProfile: typeof EXECUTION_PROFILE;
+}
+
+export interface ClaudeExecution {
+  readonly cwd: string;
+  readonly signal: AbortSignal;
+  beforeEntry(): void;
+  run(input: RunClaudeInput): Promise<RunClaudeOutput>;
+  captureOriginal(stream: AssistantMessageEventStream): AssistantMessageEventStream;
+  track<T>(pending: Promise<T>): Promise<T>;
+}
+
+export function selectedExecution(capability: ClaudeExecutionCapability, options: SimpleStreamOptions | undefined): ClaudeExecution | undefined {
+  const context = options?.metadata?.[EXECUTION_NAMESPACE] as { capability: ClaudeExecutionCapability; execution: ClaudeExecution } | undefined;
+  if (context === undefined) return undefined;
+  if (typeof context !== "object" || context === null || context.capability !== capability || typeof context.execution !== "object" || context.execution === null) throw new Error("Invalid Claude Code execution context");
+  const execution = context.execution;
+  if (typeof execution.cwd !== "string" || !isAbsolute(execution.cwd) || !(execution.signal instanceof AbortSignal) || typeof execution.beforeEntry !== "function" || typeof execution.run !== "function" || typeof execution.captureOriginal !== "function" || typeof execution.track !== "function") throw new Error("Invalid Claude Code execution dependency");
+  execution.beforeEntry();
+  return execution;
+}
