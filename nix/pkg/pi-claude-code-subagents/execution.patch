+export async function processGroupAlive(pid: number): Promise<boolean> {
+  if (!Number.isInteger(pid) || pid <= 1 || pid > 0x7fffffff) throw new Error("Invalid Claude Code process group");
+  if (groupAbsenceConfirmed(pid)) return false;
