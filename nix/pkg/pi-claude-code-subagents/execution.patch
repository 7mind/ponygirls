+      const { stdout } = await promisify(execFile)(helper, ["group", String(pid)], { timeout: 1000 });
+      if (stdout === "dead\n") return false;
+      if (stdout === "live\n") return true;
+      throw new Error("Invalid Claude Code process group observation");
+    } catch (error) {
+      if (groupAbsenceConfirmed(pid)) return false;
+      throw error;
+    }
+  }
+  if (process.platform !== "linux") return true;
+  let zombie = false;
+  for (const name of await readdir("/proc")) {
+    if (!/^\d+$/.test(name)) continue;
+    try {
+      const fields = (await readFile(`/proc/${name}/stat`, "utf8")).split(") ").pop()!.split(" ");
