+      if (fields[0] !== "Z" && fields[0] !== "X") return true;
+      zombie = true;
+    } catch (e) { if ((e as NodeJS.ErrnoException).code !== "ENOENT" && (e as NodeJS.ErrnoException).code !== "ESRCH") throw e; }
+  }
+  if (!zombie && !groupAbsenceConfirmed(pid)) throw new Error("Cannot inspect Claude Code process group");
+  return false;
