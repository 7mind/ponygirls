+const ownerGeneration = {};
+const aSubject = {};
+const bSubject = {};
+const guards: WeakRef<TuiMouseDispatchGuard>[] = [];
+function capture(target: Component, subject: object, row: number, event: TuiMouseEvent) {
+	const guard: TuiMouseDispatchGuard = { scope: ownerGeneration, subject, isValid: () => true };
