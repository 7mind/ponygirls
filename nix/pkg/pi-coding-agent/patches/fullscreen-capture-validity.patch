+	for (let index = 0; index < TRANSFER_COUNT; index++) terminal.sendInput(`\x1b[<32;${3 + (index % 2)};1M`);
+	assert.equal(guards.length, TRANSFER_COUNT + 1);
+	await collectGarbage();
+	const retainedGuards = guards.filter((reference) => reference.deref() !== undefined).length;
+	console.log(
