index 0000000..f196aac
--- /dev/null
+++ b/packages/tui/test/tui-alt-screen-gesture.test.ts
@@ -0,0 +1,369 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { MouseRegion } from "../src/components/mouse-region.ts";
+import { ScrollView } from "../src/components/scroll-view.ts";
+import { Text } from "../src/components/text.ts";
+import { VStack } from "../src/components/v-stack.ts";
+import { type Component, Container, CURSOR_MARKER, type TuiMouseEvent } from "../src/tui.ts";
+import { TuiAltScreen } from "../src/tui-alt-screen.ts";
+import { VirtualTerminal } from "./virtual-terminal.ts";
+
+const WIDTH = 40;
+const HEIGHT = 12;
+
+// Behavioral / Blackbox / Group: production layout, dispatch, and terminal rendering.
+// Regression: fullscreen capture used stale coordinates after a preceding row grew.
+describe("TuiAltScreen captured geometry", () => {
+	for (const nested of [false, true]) {
+		for (const scenario of [
+			"stable",
+			"text",
+			"moved",
+			"restored",
+			"resized",
+			"detached",
+			"replaced",
+			"root",
+		] as const) {
+			it(`${nested ? "container" : "leaf"}: ${scenario}`, async () => {
+				const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+				const tui = new TuiAltScreen(terminal, false, undefined, { copyOnSelect: false });
+				const events: string[] = [];
+				const replacementEvents: string[] = [];
+				const lead = new Text("LEAD", 0, 0);
+				const label = new Text("AGENTS", 0, 0);
+				const target = new MouseRegion(label, (event) => {
+					events.push(event.type);
+					return { handled: true, capture: true };
+				});
+				const host = new Container();
+				host.addChild(target);
+				const slot: Component = nested ? host : target;
+				const root = new VStack([
+					{ component: lead, shrink: 0 },
+					{ component: slot, shrink: 0 },
+				]);
+				tui.setLayoutRoot(root);
+				try {
+					tui.start();
+					tui.renderNow();
+					await terminal.flush();
+					assert.equal(terminal.getViewport()[1].trimEnd(), "AGENTS");
+					terminal.sendInput("\x1b[<0;2;2M");
+					assert.deepEqual(events, ["press"]);
+					switch (scenario) {
+						case "stable":
+							break;
+						case "text":
+							label.setText("AGENTS updated");
+							break;
+						case "moved":
+						case "restored":
+							lead.setText("LEAD\nLEAD");
+							break;
+						case "resized":
+							label.setText("AGENTS\nMORE");
+							break;
+						case "detached":
+							root.removeChild(slot);
+							break;
+						case "replaced":
+							root.removeChild(slot);
+							root.addChild(
+								new MouseRegion(new Text("AGENTS", 0, 0), (event) => {
+									replacementEvents.push(event.type);
+									return { handled: true };
+								}),
+							);
+							break;
+						case "root":
+							tui.setLayoutRoot(new VStack([lead, slot]));
+							break;
+					}
+					tui.renderNow();
+					await terminal.flush();
+					if (scenario === "moved" || scenario === "restored") {
+						assert.equal(terminal.getViewport()[2].trimEnd(), "AGENTS");
+					}
+					if (scenario === "restored") {
+						lead.setText("LEAD");
+						tui.renderNow();
+						await terminal.flush();
+						assert.equal(terminal.getViewport()[1].trimEnd(), "AGENTS");
+					}
+					terminal.sendInput("\x1b[<0;2;2m");
+					assert.deepEqual(
+						events,
+						scenario === "stable" || scenario === "text" ? ["press", "release", "click"] : ["press"],
+					);
+					assert.deepEqual(replacementEvents, []);
+				} finally {
+					tui.stop();
+					await terminal.flush();
+				}
+			});
+		}
+	}
+
+	for (const phase of ["press", "release"] as const) {
+		for (const mutation of ["detach", "root", "stop", "move", "restore", "stable", "overlay-close"] as const) {
+			it(`${phase} callback: ${mutation}`, async () => {
+				const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+				const tui = new TuiAltScreen(terminal, false, undefined, { copyOnSelect: false });
+				const events: string[] = [];
+				const lead = new Text("LEAD", 0, 0);
+				const root = new VStack([lead]);
+				let close = () => {};
+				const target = new MouseRegion(new Text("AGENTS", 0, 0), (event: TuiMouseEvent) => {
+					events.push(event.type);
+					if (event.type === phase) {
+						switch (mutation) {
+							case "detach":
+								root.removeChild(target);
+								break;
+							case "root":
+								tui.setLayoutRoot(new VStack([lead]));
+								break;
+							case "stop":
+								tui.stop();
+								break;
+							case "move":
+								lead.setText("LEAD\nLEAD");
+								tui.renderNow();
+								break;
+							case "restore":
+								lead.setText("LEAD\nLEAD");
+								tui.renderNow();
+								lead.setText("LEAD");
+								tui.renderNow();
+								break;
+							case "stable":
+								tui.renderNow();
+								break;
+							case "overlay-close":
+								close();
+								break;
+						}
+					}
+					return { handled: true, capture: true, focus: true, render: true };
+				});
+				root.addChild(target);
+				tui.setLayoutRoot(root);
+				if (mutation === "overlay-close") {
+					root.removeChild(target);
+					const overlay = tui.showOverlay(target, { row: 1, col: 0, width: WIDTH });
+					close = () => overlay.hide();
+				}
+				try {
+					tui.start();
+					tui.renderNow();
+					await terminal.flush();
+					assert.equal(terminal.getViewport()[1].trimEnd(), "AGENTS");
+					terminal.sendInput("\x1b[<0;2;2M");
+					await terminal.waitForRender();
+					terminal.sendInput("\x1b[<0;2;2m");
+					assert.deepEqual(
+						events,
+						mutation === "stable"
+							? ["press", "release", "click"]
+							: phase === "press"
+								? ["press"]
+								: ["press", "release"],
+					);
+					if (mutation === "detach") {
+						await terminal.waitForRender();
+						assert.equal(
+							terminal.getViewport().some((line) => line.includes("AGENTS")),
+							false,
+						);
+					}
+				} finally {
+					tui.stop();
+					await terminal.flush();
+				}
+			});
+		}
+	}
+	for (const mode of ["implicit", "overlay"] as const) {
+		it(`${mode}: preserves held capture across ordinary scheduled frames`, async () => {
+			const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+			const tui = new TuiAltScreen(terminal, false, undefined, { copyOnSelect: false });
+			const events: string[] = [];
+			const target = new MouseRegion(new Text("AGENTS", 0, 0), (event) => {
+				events.push(event.type);
+				return { handled: true, capture: true };
+			});
+			if (mode === "implicit") tui.addChild(target);
+			else tui.showOverlay(target, { row: 0, col: 0, width: WIDTH });
+			try {
+				tui.start();
+				await terminal.waitForRender();
+				assert.equal(terminal.getViewport()[0].trimEnd(), "AGENTS");
+				terminal.sendInput("\x1b[<0;2;1M");
+				for (let frame = 0; frame < 3; frame++) {
+					tui.requestRender();
+					await terminal.waitForRender();
+				}
+				terminal.sendInput("\x1b[<0;2;1m");
+				assert.deepEqual(events, ["press", "release", "click"]);
+			} finally {
+				tui.stop();
+				await terminal.flush();
+			}
+		});
+	}
+
+	for (const mutation of [
+		"line-offset",
+		"logical-height",
+		"clip",
+		"scroll-unrendered",
+		"ancestor-detach",
+		"recapture",
+	] as const) {
+		it(`cancels ${mutation} without transferring the release`, async () => {
+			const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+			const tui = new TuiAltScreen(terminal, false, undefined, { copyOnSelect: false });
+			const events: string[] = [];
+			const lines = ["AGENTS", "SECOND", "THIRD"];
+			const target = new MouseRegion({ render: () => lines, invalidate() {} }, (event) => {
+				events.push(event.type);
+				return { handled: true, capture: true };
+			});
+			const parent = new VStack([{ component: target, basis: 2, shrink: 0 }]);
+			const scroll = new ScrollView(parent);
+			const root = new VStack([{ component: scroll, basis: 1, shrink: 0 }]);
+			tui.setLayoutRoot(root);
+			try {
+				tui.start();
+				tui.renderNow();
+				await terminal.flush();
+				assert.equal(terminal.getViewport()[0].trimEnd(), "AGENTS");
+				terminal.sendInput("\x1b[<0;2;1M");
+				switch (mutation) {
+					case "line-offset":
+						lines[2] = `${CURSOR_MARKER}THIRD`;
+						break;
+					case "logical-height":
+						lines.push("FOURTH");
+						break;
+					case "clip":
+						root.clear();
+						root.addChild(scroll, { basis: 2 });
+						break;
+					case "scroll-unrendered":
+						scroll.scrollBy(1);
+						break;
+					case "ancestor-detach":
+						root.removeChild(scroll);
+						break;
+					case "recapture":
+						terminal.sendInput("\x1b[<32;3;1M");
+						root.removeChild(scroll);
+						break;
+				}
+				if (mutation !== "scroll-unrendered" && mutation !== "ancestor-detach") {
+					tui.renderNow();
+					await terminal.flush();
+				}
+				terminal.sendInput("\x1b[<0;2;1m");
+				assert.deepEqual(events, mutation === "recapture" ? ["press", "drag"] : ["press"]);
+			} finally {
+				tui.stop();
+				await terminal.flush();
+			}
+		});
+	}
+
+	it("does not recapture after a press callback stops and restarts the renderer", async () => {
+		const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+		const tui = new TuiAltScreen(terminal, false, undefined, { copyOnSelect: false });
+		const events: string[] = [];
+		const target = new MouseRegion(new Text("AGENTS", 0, 0), (event) => {
+			events.push(event.type);
+			if (event.type === "press") {
+				tui.stop();
+				tui.start();
+				tui.renderNow();
+			}
+			return { handled: true, capture: true };
+		});
+		tui.setLayoutRoot(new VStack([target]));
+		try {
+			tui.start();
+			tui.renderNow();
+			await terminal.flush();
+			terminal.sendInput("\x1b[<0;2;1M");
+			terminal.sendInput("\x1b[<0;2;1m");
+			assert.equal(events.includes("click"), false);
+		} finally {
+			tui.stop();
+			await terminal.flush();
+		}
+	});
+	it("does not dispatch a new press to a detached layout target awaiting repaint", async () => {
+		const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+		const tui = new TuiAltScreen(terminal, false, undefined, { copyOnSelect: false });
+		const events: string[] = [];
+		const target = new MouseRegion(new Text("AGENTS", 0, 0), (event) => {
+			events.push(event.type);
+			return { handled: true, capture: true };
+		});
+		const root = new VStack([target]);
+		tui.setLayoutRoot(root);
+		try {
+			tui.start();
+			tui.renderNow();
+			await terminal.flush();
+			root.removeChild(target);
+			terminal.sendInput("\x1b[<0;2;1M");
+			assert.deepEqual(events, []);
+		} finally {
+			tui.stop();
+			await terminal.flush();
+		}
+	});
+	for (const phase of ["held", "press", "release"] as const) {
+		it(`honors delegated target invalidation during ${phase} with unchanged root geometry`, async () => {
+			const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+			const tui = new TuiAltScreen(terminal, false, undefined, { copyOnSelect: false });
+			const events: string[] = [];
+			const replacements: string[] = [];
+			const host = new Container();
+			const replacement = new MouseRegion(new Text("AGENTS", 0, 0), (event) => {
+				replacements.push(event.type);
+				return { handled: true };
+			});
+			const target = new MouseRegion(new Text("AGENTS", 0, 0), (event) => {
+				events.push(event.type);
+				if (event.type === phase) {
+					host.removeChild(target);
+					host.addChild(replacement);
+				}
+				return { handled: true, capture: true, render: true };
+			});
+			host.addChild(target);
+			tui.setLayoutRoot(new VStack([host]));
+			try {
+				tui.start();
+				tui.renderNow();
+				await terminal.flush();
+				const before = terminal.getViewport();
+				terminal.sendInput("\x1b[<0;2;1M");
+				await terminal.waitForRender();
+				if (phase === "held") {
+					host.removeChild(target);
+					host.addChild(replacement);
+				}
+				terminal.sendInput("\x1b[<0;2;1m");
+				await terminal.waitForRender();
+				assert.deepEqual(events, phase === "release" ? ["press", "release"] : ["press"]);
+				assert.deepEqual(replacements, []);
+				assert.deepEqual(terminal.getViewport(), before);
+			} finally {
+				tui.stop();
+				await terminal.flush();
+			}
+		});
+	}
+});
