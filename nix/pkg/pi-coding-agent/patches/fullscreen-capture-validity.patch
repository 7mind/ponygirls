+const TRANSFER_COUNT = 10000;
+const INHERITED_SUBJECT_COUNT = 2;
+const MAX_RETAINED_GUARDS = INHERITED_SUBJECT_COUNT + 1;
+
+function historicalFrames() {
+	let aHeight = 1;
+	let bHeight = 1;
+	const a: Component = { render: () => Array(aHeight).fill("A"), invalidate() {} };
+	const b: Component = { render: () => Array(bHeight).fill("B"), invalidate() {} };
+	const root = new VStack([
+		{ component: a, basis: 2 },
+		{ component: b, basis: 2 },
+	]);
+	const scopes = new MouseLayoutScopes();
+	const previous: WeakRef<object>[] = [];
+	for (let index = 0; index < FRAME_COUNT; index++) {
+		if (index % 2 === 0) aHeight++;
+		else bHeight++;
+		const frame = renderLayoutFrame(root, 40, 12, () => {});
+		scopes.update(frame);
+		for (const child of frame.root.children) assert.equal(scopes.get(child).isValid(), true);
+		if (index < FRAME_COUNT - 1) previous.push(new WeakRef(frame.root));
+	}
+	return { scopes, previous };
+}
+
+async function collectGarbage() {
+	for (let attempt = 0; attempt < 3; attempt++) {
+		await setImmediate();
+		collect!();
+	}
+	await setImmediate();
+}
+
+const history = historicalFrames();
+await collectGarbage();
+const retainedFrames = history.previous.filter((reference) => reference.deref() !== undefined).length;
+console.log(JSON.stringify({ historicalFrames: FRAME_COUNT - 1, retainedFrames }));
+assert.equal(retainedFrames, 0, "historical layout trees must not be retained by current scope guards");
+// Keep the scope registry alive across collection; dropping it would hide the retention defect.
+history.scopes.clear();
