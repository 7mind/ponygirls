diff --git a/packages/tui/src/mouse-layout.ts b/packages/tui/src/mouse-layout.ts
new file mode 100644
index 0000000..8281e64
--- /dev/null
+++ b/packages/tui/src/mouse-layout.ts
@@ -0,0 +1,126 @@
+import type { LayoutBox, LayoutFrame } from "./layout.ts";
+import { getLayoutNode } from "./layout-node.ts";
+import type { Component, TuiMouseDispatchGuard } from "./tui.ts";
+
+interface MouseLayoutPathEntry {
+	component: Component;
+	registration: object | undefined;
+	y: number;
+}
+
+type MouseLayoutGeometry = Pick<LayoutBox, "rect" | "clip" | "lineOffset">;
+
+interface MouseLayoutScope {
+	guard: TuiMouseDispatchGuard;
+	logicalHeight: number | undefined;
+	valid: boolean;
+}
+
+/** Renderer-owned identities for structural registrations at a committed geometry generation. */
+export class MouseLayoutScopes {
+	private frame: LayoutFrame | undefined;
+	private readonly scopes = new WeakMap<LayoutBox, MouseLayoutScope>();
+
+	update(frame: LayoutFrame): void {
+		if (this.frame) this.reconcile(this.frame.root, frame.root);
+		this.frame = frame;
+	}
+
+	clear(): void {
+		if (this.frame) this.invalidate(this.frame.root);
+		this.frame = undefined;
+	}
+
+	get(box: LayoutBox): TuiMouseDispatchGuard {
+		const existing = this.scopes.get(box);
+		if (existing) return existing.guard;
+		// Capturing a LayoutBox would retain its historical parents and sibling frame trees.
+		const path: MouseLayoutPathEntry[] = [];
+		for (let entry: LayoutBox | undefined = box; entry; entry = entry.parent) {
+			path.unshift({ component: entry.component, registration: entry.registration, y: entry.rect.y });
+		}
+		const geometry: MouseLayoutGeometry = { rect: box.rect, clip: box.clip, lineOffset: box.lineOffset };
+		const scope: MouseLayoutScope = {
+			logicalHeight: box.lines?.length,
+			valid: true,
+			guard: {
+				scope: {},
+				subject: box.registration ?? box.component,
+				isValid: () => {
+					const current = this.resolve(path);
+					scope.valid &&= current !== undefined && sameGeometry(geometry, current, scope.logicalHeight);
+					return scope.valid;
+				},
+			},
+		};
+		this.scopes.set(box, scope);
+		return scope.guard;
+	}
+
+	private reconcile(previous: LayoutBox, current: LayoutBox): void {
+		if (previous.component !== current.component || previous.registration !== current.registration) {
+			this.invalidate(previous);
+			return;
+		}
+		const scope = this.scopes.get(previous);
+		if (scope) {
+			if (scope.valid && sameGeometry(previous, current, scope.logicalHeight)) this.scopes.set(current, scope);
+			else scope.valid = false;
+		}
+		const children = new Map(current.children.map((child) => [child.registration, child]));
+		for (const child of previous.children) {
+			const next = children.get(child.registration);
+			if (next) this.reconcile(child, next);
+			else this.invalidate(child);
+		}
+	}
+
+	private invalidate(box: LayoutBox): void {
+		const scope = this.scopes.get(box);
+		if (scope) scope.valid = false;
+		for (const child of box.children) this.invalidate(child);
+	}
+
+	private resolve(path: readonly MouseLayoutPathEntry[]): LayoutBox | undefined {
+		const frame = this.frame;
+		if (!frame) return undefined;
+		let current = frame.root;
+		for (let index = 0; index < path.length; index++) {
+			const entry = path[index]!;
+			if (index > 0) {
+				const node = getLayoutNode(current.component);
+				if (!node) return undefined;
+				const mounted =
+					node.type === "scroll"
+						? node.component === entry.registration && node.state.scrollTop === current.rect.y - entry.y
+						: node.entries.some(
+								(candidate) =>
+									(candidate.registration ?? candidate) === entry.registration &&
+									candidate.component === entry.component &&
+									(candidate.visible?.(frame) ?? true),
+							);
+				if (!mounted) return undefined;
+				const child = current.children.find((candidate) => candidate.registration === entry.registration);
+				if (!child) return undefined;
+				current = child;
+			}
+			if (current.component !== entry.component || current.registration !== entry.registration) return undefined;
+		}
+		return current;
+	}
+}
+
+function sameGeometry(a: MouseLayoutGeometry, b: LayoutBox, logicalHeight: number | undefined): boolean {
+	return (
+		a.rect.x === b.rect.x &&
+		a.rect.y === b.rect.y &&
+		a.rect.width === b.rect.width &&
+		a.rect.height === b.rect.height &&
+		a.clip.x === b.clip.x &&
+		a.clip.y === b.clip.y &&
+		a.clip.width === b.clip.width &&
+		a.clip.height === b.clip.height &&
+		a.lineOffset === b.lineOffset &&
+		logicalHeight === b.lines?.length
+	);
+}
