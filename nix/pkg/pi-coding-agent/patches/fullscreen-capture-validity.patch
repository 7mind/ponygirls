+			const child: Component = {
+				render: () => ["CHILD"],
+				invalidate() {},
+				handleMouse(event) {
+					childEvents.push(event.type);
+					return { handled: true, capture: true, render: false };
+				},
+			};
+			let transferred = false;
+			const host: Component = {
+				render: (width) => child.render(width),
+				invalidate() {},
+				handleMouse(event) {
+					hostEvents.push(event.type);
+					if (event.type === "drag" && !transferred) {
+						transferred = true;
+						return dispatchMouseEvent(child, event);
+					}
+					return { handled: true, capture: capturePress, render: false };
+				},
+			};
+			tui.setLayoutRoot(new VStack([host]));
+			try {
+				tui.start();
+				tui.renderNow();
+				await terminal.flush();
+				assert.equal(terminal.getViewport()[0].trimEnd(), "CHILD");
+				terminal.sendInput("\x1b[<0;2;1M");
+				terminal.sendInput("\x1b[<32;3;1M");
+				terminal.sendInput("\x1b[<32;4;1M");
+				terminal.sendInput("\x1b[<0;4;1m");
+				assert.deepEqual(hostEvents, ["press", "drag"]);
+				assert.deepEqual(childEvents, ["drag", "drag", "release"]);
+			} finally {
+				tui.stop();
+				await terminal.flush();
+			}
+		});
+	}
+
+	it("keeps same-target repeated capture validation bounded over 10000 drag reports", async (t) => {
+		const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+		const tui = new TuiAltScreen(terminal, false, undefined, { copyOnSelect: false });
+		let drags = 0;
+		let releases = 0;
+		let validations = 0;
+		const target: Component = {
+			render: () => ["TARGET"],
+			invalidate() {},
+			handleMouse(event) {
+				if (event.type === "drag") drags++;
+				if (event.type === "release") releases++;
+				return {
+					handled: true,
+					capture: true,
+					render: false,
+					target: {
+						component: target,
+						originX: event.screenX - event.x,
+						originY: event.screenY - event.y,
+						width: event.width,
+						height: event.height,
+						validity: {
+							path: [],
+							current: () => {
+								validations++;
+								return true;
+							},
+						},
+					},
+				};
+			},
+		};
+		tui.setLayoutRoot(new VStack([target]));
+		try {
+			tui.start();
+			tui.renderNow();
+			await terminal.flush();
+			terminal.sendInput("\x1b[<0;2;1M");
+			for (let index = 0; index < DRAG_REPORTS; index++) terminal.sendInput(`\x1b[<32;${3 + (index % 2)};1M`);
+			terminal.sendInput("\x1b[<0;4;1m");
+			t.diagnostic(JSON.stringify({ reports: DRAG_REPORTS, validations, drags, releases }));
+			assert.equal(drags, DRAG_REPORTS);
+			assert.equal(releases, 1);
+			assert.ok(validations <= MAX_VALIDATIONS_PER_REPORT * (DRAG_REPORTS + 2), `validation calls: ${validations}`);
+		} finally {
+			tui.stop();
+			await terminal.flush();
+		}
+	});
+
+	for (const phase of ["drag", "release"] as const) {
+		it(`honors a new same-component capture validity predicate returned on ${phase}`, async () => {
+			const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+			const tui = new TuiAltScreen(terminal, false, undefined, { copyOnSelect: false });
+			const events: string[] = [];
+			let captureValid = phase === "drag";
+			const target: Component = {
+				render: () => ["TARGET"],
+				invalidate() {},
+				handleMouse(event) {
+					events.push(event.type);
+					if (event.type !== phase) return { handled: true, capture: true, render: false };
+					return {
+						handled: true,
+						capture: true,
+						render: false,
+						target: {
+							component: target,
+							originX: event.screenX - event.x,
+							originY: event.screenY - event.y,
+							width: event.width,
+							height: event.height,
+							validity: { path: [], current: () => captureValid },
+						},
+					};
+				},
+			};
+			tui.setLayoutRoot(new VStack([target]));
+			try {
+				tui.start();
+				tui.renderNow();
+				await terminal.flush();
+				terminal.sendInput("\x1b[<0;2;1M");
+				if (phase === "drag") {
+					terminal.sendInput("\x1b[<32;3;1M");
+					captureValid = false;
+				}
+				terminal.sendInput("\x1b[<0;2;1m");
+				assert.deepEqual(events, phase === "drag" ? ["press", "drag"] : ["press", "release"]);
+			} finally {
+				tui.stop();
+				await terminal.flush();
+			}
+		});
+	}
+	for (const depth of [1, 2]) {
+		for (const removal of ["none", "delegated", "press-root"] as const) {
+			it(`preserves transfer-path guards after recapture (depth: ${depth}, removal: ${removal})`, async () => {
+				const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+				const tui = new TuiAltScreen(terminal, false, undefined, { copyOnSelect: false });
+				const events: string[] = [];
+				const child: Component = {
+					render: () => ["CHILD"],
+					invalidate() {},
+					handleMouse(event) {
+						events.push(event.type);
+						return { handled: true, capture: true, render: false };
+					},
+				};
+				const host = new CaptureThenDelegate();
+				const intermediate = new CaptureThenDelegate();
+				if (depth === 2) {
+					intermediate.addChild(child);
+					host.addChild(intermediate);
+				} else host.addChild(child);
+				tui.setLayoutRoot(new VStack([host]));
+				try {
+					tui.start();
+					tui.renderNow();
+					await terminal.flush();
+					const before = terminal.getViewport();
+					terminal.sendInput("\x1b[<0;2;1M");
+					for (let transfer = 0; transfer < depth; transfer++) terminal.sendInput("\x1b[<32;3;1M");
+					terminal.sendInput("\x1b[<32;4;1M");
+					assert.deepEqual(host.events, ["press", "drag"]);
+					assert.deepEqual(events, ["drag", "drag"]);
+					if (removal === "delegated") {
+						host.removeChild(depth === 2 ? intermediate : child);
+						host.addChild({ render: () => ["CHILD"], invalidate() {} });
+					} else if (removal === "press-root") {
+						tui.setLayoutRoot(new VStack([host]));
+					}
+					tui.renderNow();
+					await terminal.flush();
+					assert.deepEqual(terminal.getViewport(), before);
+					terminal.sendInput("\x1b[<0;4;1m");
+					assert.deepEqual(events, removal === "none" ? ["drag", "drag", "release"] : ["drag", "drag"]);
+				} finally {
+					tui.stop();
+					await terminal.flush();
+				}
+			});
+		}
+	}
+	it("retains a fresh same-component constraint when its next recapture omits the predicate", async () => {
+		const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+		const tui = new TuiAltScreen(terminal, false, undefined, { copyOnSelect: false });
+		const events: string[] = [];
+		let constraintValid = true;
+		const target: Component = {
+			render: () => ["TARGET"],
+			invalidate() {},
+			handleMouse(event) {
+				events.push(event.type);
+				if (events.length !== 2) return { handled: true, capture: true, render: false };
+				return {
+					handled: true,
+					capture: true,
+					render: false,
+					target: {
+						component: target,
+						originX: event.screenX - event.x,
+						originY: event.screenY - event.y,
+						width: event.width,
+						height: event.height,
+						validity: { path: [], current: () => constraintValid },
+					},
+				};
+			},
+		};
+		tui.setLayoutRoot(new VStack([target]));
+		try {
+			tui.start();
+			tui.renderNow();
+			await terminal.flush();
+			terminal.sendInput("\x1b[<0;2;1M");
+			terminal.sendInput("\x1b[<32;3;1M");
+			terminal.sendInput("\x1b[<32;4;1M");
+			constraintValid = false;
+			terminal.sendInput("\x1b[<0;4;1m");
+			assert.deepEqual(events, ["press", "drag", "drag"]);
+		} finally {
+			tui.stop();
+			await terminal.flush();
+		}
+	});
+});
diff --git a/packages/tui/test/tui-alt-screen-gesture.test.ts b/packages/tui/test/tui-alt-screen-gesture.test.ts
