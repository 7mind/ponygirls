@@ -0,0 +1,128 @@
+import { TuiAltScreen, type TuiMouseEvent } from "@earendil-works/pi-tui";
+import { describe, expect, it, vi } from "vitest";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal.ts";
+import { KeybindingsManager } from "../src/core/keybindings.ts";
+import { CustomEditor } from "../src/modes/interactive/components/custom-editor.ts";
+import { getEditorTheme, initTheme } from "../src/modes/interactive/theme/theme.ts";
+
+describe("editor border mouse gestures", () => {
+	it("does not refocus the editor after a badge opens another component", async () => {
+		initTheme("dark");
+		const terminal = new VirtualTerminal(30, 8);
+		const tui = new TuiAltScreen(terminal, undefined, undefined, { copyOnSelect: false });
+		const editor = new CustomEditor(tui, getEditorTheme(), KeybindingsManager.create());
+		const details = { render: () => ["details"], invalidate() {} };
+		editor.setBorderContent("topLeft", "badge", {
+			render: () => "badge",
+			handleMouse(event) {
+				if (event.type === "click") {
+					tui.setLayoutRoot(details);
+					tui.setFocus(details);
+				}
+				return { handled: true, focus: true };
+			},
+		});
+		tui.setLayoutRoot(editor);
+		tui.setFocus(editor);
+		tui.start();
+		try {
+			await terminal.waitForRender();
+			terminal.sendInput("\x1b[<0;4;1M");
+			terminal.sendInput("\x1b[<0;4;1m");
+			expect(tui.getFocusedComponent()).toBe(details);
+		} finally {
+			tui.stop();
+		}
+	});
+	it("does not synthesize a badge click after its release opens another component", async () => {
+		initTheme("dark");
+		const terminal = new VirtualTerminal(30, 8);
+		const tui = new TuiAltScreen(terminal, undefined, undefined, { copyOnSelect: false });
+		const editor = new CustomEditor(tui, getEditorTheme(), KeybindingsManager.create());
+		const details = { render: () => ["details"], invalidate() {} };
+		const events: string[] = [];
+		editor.setBorderContent("topLeft", "badge", {
+			render: () => "badge",
+			handleMouse(event) {
+				events.push(event.type);
+				if (event.type === "release") {
+					tui.setLayoutRoot(details);
+					tui.setFocus(details);
+				}
+				return { handled: true };
+			},
+		});
+		tui.setLayoutRoot(editor);
+		tui.setFocus(editor);
+		tui.start();
+		try {
+			await terminal.waitForRender();
+			terminal.sendInput("\x1b[<0;4;1M");
+			terminal.sendInput("\x1b[<0;4;1m");
+			expect(events).toEqual(["press", "release"]);
+			expect(tui.getFocusedComponent()).toBe(details);
+		} finally {
+			tui.stop();
+		}
+	});
+
+	it("allows an editor-body click after dragging a border badge", async () => {
+		initTheme("dark");
+		const terminal = new VirtualTerminal(30, 8);
+		const tui = new TuiAltScreen(terminal, undefined, undefined, { copyOnSelect: false });
+		const editor = new CustomEditor(tui, getEditorTheme(), KeybindingsManager.create());
+		const events: string[] = [];
+		editor.setText("draft");
+		editor.setBorderContent("topLeft", "badge", {
+			render: () => "badge",
+			handleMouse(event) {
+				events.push(event.type);
+				return { handled: true };
+			},
+		});
+		tui.setLayoutRoot(editor);
+		tui.setFocus(editor);
+		tui.start();
+		try {
+			await terminal.waitForRender();
+			terminal.sendInput("\x1b[<0;4;1M");
+			terminal.sendInput("\x1b[<32;6;1M");
+			terminal.sendInput("\x1b[<0;6;1m");
+			expect(events).toEqual(["press", "drag", "release"]);
+			terminal.sendInput("\x1b[<0;1;2M");
+			terminal.sendInput("\x1b[<0;1;2m");
+			expect(events).toEqual(["press", "drag", "release"]);
+			expect(editor.getCursor()).toEqual({ line: 0, col: 0 });
+		} finally {
+			tui.stop();
+		}
+	});
+
+	it.each([false, true])("does not deliver an old press to replacement content (retained: %s)", async (retained) => {
+		initTheme("dark");
+		const terminal = new VirtualTerminal(30, 8);
+		const tui = new TuiAltScreen(terminal, undefined, undefined, { copyOnSelect: false });
+		const editor = new CustomEditor(tui, getEditorTheme(), KeybindingsManager.create());
+		const old = vi.fn(() => ({ handled: true }));
+		const replacement = vi.fn((_event: TuiMouseEvent) => ({ handled: true }));
+		editor.setBorderContent("topLeft", "badge", { render: () => "badge", handleMouse: old });
+		tui.setLayoutRoot(retained ? editor.createBorderComponent("top", () => true) : editor);
+		tui.start();
+		try {
+			await terminal.waitForRender();
+			terminal.sendInput("\x1b[<0;4;1M");
+			expect(old).toHaveBeenCalledTimes(1);
+			editor.setBorderContent("topLeft", "badge", { render: () => "badge", handleMouse: replacement });
+			await terminal.waitForRender();
+			terminal.sendInput("\x1b[<0;4;1m");
+			expect(old).toHaveBeenCalledTimes(1);
+			expect(replacement).not.toHaveBeenCalled();
+			terminal.sendInput("\x1b[<0;4;1M");
+			await terminal.waitForRender();
+			terminal.sendInput("\x1b[<0;4;1m");
+			expect(replacement.mock.calls.map(([event]) => event.type)).toEqual(["press", "release", "click"]);
+		} finally {
+			tui.stop();
+		}
+	});
+});
