@@ -0,0 +1,69 @@
+/** Click the border badge twice, or run /border-details, without losing the editor draft. */
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { truncateToWidth } from "@earendil-works/pi-tui";
+
+export default function retainedBorderDetails(pi: ExtensionAPI) {
+	let active: { close: () => void } | undefined;
+
+	const toggle = async (ctx: ExtensionContext) => {
+		if (ctx.mode !== "tui") {
+			ctx.ui.notify("border-details requires interactive mode", "error");
+			return;
+		}
+		if (active) {
+			active.close();
+			return;
+		}
+		const interaction = { close: () => {} };
+		active = interaction;
+		try {
+			await ctx.ui.custom<void>(
+				(_tui, theme, keybindings, done) => {
+					interaction.close = () => done();
+					return {
+						render: (width) =>
+							[
+								theme.fg("accent", "Border details"),
+								"The editor draft is hidden and preserved.",
+								"Click Details again or use the cancel key to close.",
+							].map((line) => truncateToWidth(line, width)),
+						handleInput: (data) => {
+							if (keybindings.matches(data, "tui.select.cancel")) done();
+						},
+						invalidate() {},
+					};
+				},
+				{ retainEditorBorders: true },
+			);
+		} finally {
+			if (active === interaction) active = undefined;
+		}
+	};
+
+	pi.registerCommand("border-details", {
+		description: "Toggle details while retaining editor border widgets",
+		handler: async (_args, ctx) => toggle(ctx),
+	});
+	pi.on("session_start", (_event, ctx) => {
+		if (ctx.mode !== "tui") return;
+		ctx.ui.setWidget(
+			"border-details",
+			(_tui, theme) => ({
+				render: () => [theme.fg("accent", "Details")],
+				renderCompact: () => "?",
+				handleMouse: (event) => {
+					if (event.type === "click" && event.button === "left") {
+						void toggle(ctx).catch((error: unknown) => ctx.ui.notify(String(error), "error"));
+					}
+					return { handled: true };
+				},
+				invalidate() {},
+			}),
+			{ placement: "borderBottomRight" },
+		);
+	});
+	pi.on("session_shutdown", () => {
+		active?.close();
+		active = undefined;
+	});
+}
