diff --git a/packages/coding-agent/test/retained-custom-message-ingress.test.ts b/packages/coding-agent/test/retained-custom-message-ingress.test.ts
new file mode 100644
index 0000000..349300f
--- /dev/null
+++ b/packages/coding-agent/test/retained-custom-message-ingress.test.ts
@@ -0,0 +1,175 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { Agent } from "@earendil-works/pi-agent-core";
+import { type AssistantMessage, createAssistantMessageEventStream, getModel } from "@earendil-works/pi-ai/compat";
+import type { TranscriptContext } from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { AgentSession } from "../src/core/agent-session.ts";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import type { BeforeAgentStartTrigger } from "../src/core/extensions/runner.ts";
+import { convertToLlm } from "../src/core/messages.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { SettingsManager } from "../src/core/settings-manager.ts";
+import { createModelRegistry, getModelRuntime } from "./model-runtime-test-utils.ts";
+import { createTestResourceLoader } from "./utilities.ts";
+
+const cleanups: Array<() => void> = [];
+
+afterEach(() => {
+	while (cleanups.length) cleanups.pop()?.();
+	vi.useRealTimers();
+});
+
+function assistantMessage(text: string): AssistantMessage {
+	return {
+		role: "assistant",
+		content: [{ type: "text", text }],
+		api: "anthropic-messages",
+		provider: "anthropic",
+		model: "mock",
+		usage: {
+			input: 0,
+			output: 0,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 0,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+		stopReason: "stop",
+		timestamp: Date.now(),
+	};
+}
+
+async function createSession(resourceLoader = createTestResourceLoader()) {
+	const directory = mkdtempSync(join(tmpdir(), "pi-retained-ingress-"));
+	const requests: TranscriptContext[] = [];
+	const model = getModel("anthropic", "claude-sonnet-4-5")!;
+	const agent = new Agent({
+		getApiKey: () => "test-key",
+		convertToLlm,
+		initialState: { model, systemPrompt: "Test", tools: [] },
+		streamFn: (_model, context) => {
+			requests.push(context);
+			const stream = createAssistantMessageEventStream();
+			queueMicrotask(() => {
+				const message = assistantMessage("Synthetic completion");
+				stream.push({ type: "start", partial: message });
+				stream.push({ type: "done", reason: "stop", message });
+				stream.end();
+			});
+			return stream;
+		},
+	});
+	const sessionManager = SessionManager.inMemory(directory);
+	const settingsManager = SettingsManager.inMemory({ retry: { enabled: false } });
+	const authStorage = AuthStorage.create(join(directory, "auth.json"));
+	await authStorage.modify("anthropic", async () => ({ type: "api_key", key: "test-key" }));
+	const modelRegistry = await createModelRegistry(authStorage, join(directory, "models.json"));
+	const session = new AgentSession({
+		agent,
+		sessionManager,
+		settingsManager,
+		cwd: directory,
+		modelRuntime: getModelRuntime(modelRegistry),
+		resourceLoader,
+	});
+	cleanups.push(() => {
+		session.dispose();
+		rmSync(directory, { recursive: true, force: true });
+	});
+	return { session, requests, resourceLoader };
+}
+
+function enqueueRetainedWake(session: AgentSession): void {
+	// This is the same internal entry point ExtensionRunner exposes as enqueueMessage.
+	(session as unknown as {
+		_enqueueCustomMessage(
+			message: { customType: string; content: string; display: boolean },
+			options: { triggerTurn: boolean; deliverAs: "followUp" },
+		): void;
+	})._enqueueCustomMessage(
+		{ customType: "retained-test", content: "retained context", display: true },
+		{ triggerTurn: true, deliverAs: "followUp" },
+	);
+}
+
+function contextText(context: TranscriptContext): string {
+	return JSON.stringify(context.messages);
+}
+
+describe("retained custom-message lifecycle regressions", () => {
+	it("does not start a retained run when an event subscriber begins a prompt during flush", async () => {
+		// Regression: prompt() yields during preflight after the subscriber returns.
+		const { session, requests } = await createSession();
+		const runStarts: string[] = [];
+		const internal = session as unknown as {
+			_startRun(
+				trigger: BeforeAgentStartTrigger,
+				onStarted: (() => void) | undefined,
+				triggerCommitted: boolean,
+			): Promise<void>;
+		};
+		const originalStartRun = internal._startRun;
+		internal._startRun = async function (trigger, onStarted, triggerCommitted) {
+			runStarts.push(trigger.messageType);
+			return originalStartRun.call(this, trigger, onStarted, triggerCommitted);
+		};
+		let promptResult: Promise<Error | undefined> | undefined;
+		session.subscribe((event) => {
+			if (event.type === "message_start" && event.message.role === "custom" && !promptResult) {
+				promptResult = session.prompt("subscriber prompt").then(
+					() => undefined,
+					(error: unknown) => (error instanceof Error ? error : new Error(String(error))),
+				);
+			}
+		});
+
+		// Hold the accepted message in the real pending/retained state until the
+		// scheduled drain's flush emits message_start to the subscriber above.
+		const flushing = session as unknown as { _flushingCustomMessages: boolean };
+		flushing._flushingCustomMessages = true;
+		enqueueRetainedWake(session);
+		flushing._flushingCustomMessages = false;
+		await (session as unknown as { _drainCustomMessages(): Promise<void> })._drainCustomMessages();
+		const promptError = await promptResult;
+
+		expect(promptError).toBeUndefined();
+		expect(runStarts).toEqual(["user"]);
+		expect(requests).toHaveLength(1);
+		expect(contextText(requests[0])).toContain("subscriber prompt");
+		expect(contextText(requests[0])).toContain("retained context");
+	});
+
+	it("fences the zero-delay retained drain across reload without losing the accepted wake", async () => {
+		// Regression: reload's first idle check succeeds, then its timer races the awaited resource reload.
+		const resourceLoader = createTestResourceLoader();
+		const originalReload = resourceLoader.reload.bind(resourceLoader);
+		let releaseReload!: () => void;
+		const reloadGate = new Promise<void>((resolve) => {
+			releaseReload = resolve;
+		});
+		let markReloadStarted!: () => void;
+		const reloadStarted = new Promise<void>((resolve) => {
+			markReloadStarted = resolve;
+		});
+		resourceLoader.reload = async () => {
+			markReloadStarted();
+			await reloadGate;
+			return originalReload();
+		};
+		const { session, requests } = await createSession(resourceLoader);
+
+		enqueueRetainedWake(session);
+		const reloading = session.reload();
+		await reloadStarted;
+		await new Promise((resolve) => setTimeout(resolve, 30));
+		const callsDuringReload = requests.length;
+		releaseReload();
+		await reloading;
+		await vi.waitFor(() => expect(requests).toHaveLength(1));
+
+		expect(callsDuringReload).toBe(0);
+		expect(contextText(requests[0])).toContain("retained context");
+	});
+});
