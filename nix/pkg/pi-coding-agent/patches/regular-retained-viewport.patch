diff --git a/packages/coding-agent/test/interactive-retained-viewport.test.ts b/packages/coding-agent/test/interactive-retained-viewport.test.ts
new file mode 100644
index 0000000..668ffe7
--- /dev/null
+++ b/packages/coding-agent/test/interactive-retained-viewport.test.ts
@@ -0,0 +1,303 @@
+import {
+	type Component,
+	type Container,
+	ScrollView,
+	Text,
+	type TUI,
+	type TuiMainScreen,
+	VStack,
+} from "@earendil-works/pi-tui";
+import { describe, expect, it, vi } from "vitest";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal.ts";
+import type { AgentSessionRuntime } from "../src/core/agent-session-runtime.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { SettingsManager } from "../src/core/settings-manager.ts";
+import type { CustomEditor } from "../src/modes/interactive/components/custom-editor.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+
+type Host = {
+	renderer: TuiMainScreen;
+	editor: CustomEditor;
+	editorContainer: VStack;
+	widgetContainerBelow: Container;
+	footerContainer: Container;
+	programStatus: { setBlocked: ReturnType<typeof vi.fn> };
+	themeController: { dispose(): void };
+	footer: { dispose(): void };
+	footerDataProvider: { dispose(): void };
+	showExtensionCustom(
+		factory: (tui: TUI, theme: unknown, keys: unknown, done: () => void) => Component,
+		options: { retainEditorBorders: boolean },
+	): Promise<void>;
+};
+
+function host(terminal: VirtualTerminal): Host {
+	const runtime = {
+		session: {
+			settingsManager: SettingsManager.inMemory({ tuiMode: "regular", regularMouse: true, theme: "dark" }),
+			sessionManager: SessionManager.inMemory("/tmp"),
+			autoCompactionEnabled: false,
+			resourceLoader: { getThemes: () => ({ themes: [] }) },
+		},
+		setBeforeSessionInvalidate: () => {},
+		setRebindSession: () => {},
+	};
+	// Exercise the real constructor; the fixture supplies only its runtime dependencies and never starts a session.
+	const mode = new InteractiveMode(runtime as unknown as AgentSessionRuntime, { terminal });
+	const result = mode as unknown as Host;
+	result.programStatus = { setBlocked: vi.fn() };
+	result.footerContainer.clear();
+	result.renderer.addChild(result.editorContainer);
+	result.renderer.addChild(result.widgetContainerBelow);
+	result.renderer.addChild(result.footerContainer);
+	return result;
+}
+
+function dispose(h: Host): void {
+	h.renderer.stop();
+	h.themeController.dispose();
+	h.footer.dispose();
+	h.footerDataProvider.dispose();
+}
+
+describe("regular retained inline viewport", () => {
+	it("does not render a phantom editor row when the actual dock consumes the terminal", async () => {
+		const terminal = new VirtualTerminal(48, 12);
+		const h = host(terminal);
+		let done: () => void = () => {};
+		try {
+			h.editor.setBorderContent("topLeft", "top", { render: () => "TOP BADGE" });
+			h.footerContainer.addChild(new Text(Array.from({ length: 10 }, (_, i) => `FOOTER ${i}`).join("\n"), 0, 0));
+			h.widgetContainerBelow.addChild(new Text("BELOW 0\nBELOW 1", 0, 0));
+			const panel = new Text("BODY", 0, 0);
+			const dialog = h.showExtensionCustom(
+				(_tui, _theme, _keys, finish) => {
+					done = finish;
+					return panel;
+				},
+				{ retainEditorBorders: true },
+			);
+			await vi.waitFor(() => expect(h.editorContainer.children).toContain(panel));
+			expect(h.editorContainer.render(48)).toEqual([]);
+			h.renderer.start();
+			h.renderer.renderNow();
+			await terminal.flush();
+			const screen = terminal.getViewport().join("\n");
+			expect(screen).toContain("BELOW 0");
+			expect(screen).toContain("FOOTER 9");
+			expect(screen).not.toContain("BODY");
+			done();
+			await dialog;
+		} finally {
+			done();
+			dispose(h);
+		}
+	});
+
+	it("keeps the same top badge clickable across a held press and restores the draft", async () => {
+		const terminal = new VirtualTerminal(48, 12);
+		const h = host(terminal);
+		const events: string[] = [];
+		let done: () => void = () => {};
+		try {
+			h.editor.setText("private draft");
+			h.editor.setBorderContent("topLeft", "top", {
+				render: () => "TOP BADGE",
+				handleMouse: (event) => {
+					events.push(event.type);
+					if (event.type === "click") done();
+					return { handled: true, focus: true };
+				},
+			});
+			h.editor.setBorderContent("bottomLeft", "bottom", { render: () => "BOTTOM BADGE" });
+			h.footerContainer.addChild(new Text("FOOTER 0\nFOOTER 1", 0, 0));
+			const scroll = new ScrollView(new Text(Array.from({ length: 20 }, (_, i) => `BODY ${i}`).join("\n"), 0, 0));
+			const panel = new VStack([
+				{ component: new Text("HEADER", 0, 0), shrink: 0 },
+				{ component: scroll, grow: 1, shrink: 1, minSize: 0 },
+				{ component: new Text("CLOSE", 0, 0), shrink: 0 },
+			]);
+			const dialog = h.showExtensionCustom(
+				(_tui, _theme, _keys, finish) => {
+					done = finish;
+					return panel;
+				},
+				{ retainEditorBorders: true },
+			);
+			await vi.waitFor(() => expect(h.editorContainer.children).toContain(panel));
+			h.renderer.start();
+			h.renderer.renderNow();
+			await terminal.flush();
+			terminal.sendInput(`\x1b[${terminal.getCursorPosition().y + 1};1R`);
+			expect(terminal.getViewport()[0]).toContain("TOP BADGE");
+			terminal.sendInput("\x1b[<0;4;1M");
+			expect(events).toEqual(["press"]);
+			await new Promise((resolve) => setTimeout(resolve, 30));
+			h.renderer.renderNow();
+			await terminal.flush();
+			expect(h.renderer.getFocusedComponent()).toBe(panel);
+			terminal.sendInput("\x1b[<0;4;1m");
+			expect(events).toEqual(["press", "release", "click"]);
+			await dialog;
+			h.renderer.renderNow();
+			await terminal.flush();
+			expect(terminal.getViewport().join("\n")).toContain("private draft");
+			expect(h.renderer.getFocusedComponent()).toBe(h.editor);
+		} finally {
+			done();
+			dispose(h);
+		}
+	});
+	it("remeasures wrapped below widgets, custom footers, and terminal resize", async () => {
+		const terminal = new VirtualTerminal(48, 12);
+		const h = host(terminal);
+		let done: () => void = () => {};
+		try {
+			h.editor.setBorderContent("topLeft", "top", { render: () => "TOP BADGE" });
+			h.editor.setBorderContent("bottomLeft", "bottom", { render: () => "BOTTOM BADGE" });
+			const scroll = new ScrollView(new Text(Array.from({ length: 30 }, (_, i) => `BODY ${i}`).join("\n"), 0, 0));
+			const panel = new VStack([
+				{ component: new Text("HEADER", 0, 0), shrink: 0 },
+				{ component: scroll, grow: 1, shrink: 1, minSize: 0 },
+				{ component: new Text("CLOSE", 0, 0), shrink: 0 },
+			]);
+			h.footerContainer.addChild(new Text("FOOTER 0\nFOOTER 1", 0, 0));
+			const dialog = h.showExtensionCustom(
+				(_tui, _theme, _keys, finish) => {
+					done = finish;
+					return panel;
+				},
+				{ retainEditorBorders: true },
+			);
+			await vi.waitFor(() => expect(h.editorContainer.children).toContain(panel));
+			h.renderer.start();
+			h.renderer.renderNow();
+			await terminal.flush();
+			expect(scroll.viewportHeight).toBe(6);
+			h.widgetContainerBelow.addChild(new Text("word ".repeat(12), 0, 0));
+			h.footerContainer.addChild(new Text("FOOTER 2\nFOOTER 3", 0, 0));
+			h.renderer.renderNow();
+			await terminal.flush();
+			expect(scroll.viewportHeight).toBe(2);
+			scroll.scrollToEnd();
+			h.renderer.renderNow();
+			await terminal.flush();
+			expect(terminal.getViewport().join("\n")).toContain("BODY 29");
+			terminal.resize(80, 18);
+			h.renderer.renderNow();
+			await terminal.flush();
+			expect(scroll.viewportHeight).toBe(9);
+			expect(terminal.getViewport().join("\n")).toContain("TOP BADGE");
+			done();
+			await dialog;
+		} finally {
+			done();
+			dispose(h);
+		}
+	});
+	it("leaves the normal editor, legacy custom views, and directly mounted selectors intrinsic", async () => {
+		const terminal = new VirtualTerminal(48, 12);
+		const h = host(terminal);
+		let done: () => void = () => {};
+		try {
+			expect(h.editorContainer.render(48)).toEqual(h.editor.render(48));
+			const panel = new Text(Array.from({ length: 20 }, (_, i) => `LEGACY ${i}`).join("\n"), 0, 0);
+			const legacy = h.showExtensionCustom(
+				(_tui, _theme, _keys, finish) => {
+					done = finish;
+					return panel;
+				},
+				{ retainEditorBorders: false },
+			);
+			await vi.waitFor(() => expect(h.editorContainer.children).toContain(panel));
+			expect(h.editorContainer.render(48)).toHaveLength(20);
+			done();
+			await legacy;
+			h.editor.setBorderContent("topLeft", "top", { render: () => "TOP BADGE" });
+			const retained = h.showExtensionCustom(
+				(_tui, _theme, _keys, finish) => {
+					done = finish;
+					return panel;
+				},
+				{ retainEditorBorders: true },
+			);
+			await vi.waitFor(() => expect(h.editorContainer.children).toContain(panel));
+			expect(h.editorContainer.render(48).length).toBeLessThanOrEqual(12);
+			h.editorContainer.clear();
+			h.editorContainer.addChild(new Text(Array.from({ length: 20 }, (_, i) => `SELECTOR ${i}`).join("\n"), 0, 0));
+			expect(h.editorContainer.render(48)).toHaveLength(20);
+			done();
+			await retained;
+		} finally {
+			done();
+			dispose(h);
+		}
+	});
+
+	it.each([
+		[2, 0, false, 2],
+		[4, 0, false, 2],
+		[2, 2, false, 2],
+		[2, 0, true, 2],
+		[3, 0, false, 0],
+		[3, 0, false, 1],
+	] as const)(
+		"allocates the real editor slot with footer=%i below=%i zeroBasis=%s edges=%i",
+		async (footerRows, belowRows, zeroBasis, edges) => {
+			const terminal = new VirtualTerminal(48, 12);
+			const h = host(terminal);
+			let done: () => void = () => {};
+			try {
+				if (edges > 0) h.editor.setBorderContent("topLeft", "top", { render: () => "TOP BADGE" });
+				if (edges > 1) h.editor.setBorderContent("bottomLeft", "bottom", { render: () => "BOTTOM BADGE" });
+				h.editor.setText("private draft");
+				h.footerContainer.addChild(
+					new Text(Array.from({ length: footerRows }, (_, i) => `FOOTER ${i}`).join("\n"), 0, 0),
+				);
+				if (belowRows)
+					h.widgetContainerBelow.addChild(
+						new Text(Array.from({ length: belowRows }, (_, i) => `BELOW ${i}`).join("\n"), 0, 0),
+					);
+				const panel = new VStack([
+					{ component: new Text("HEADER", 0, 0), shrink: 0 },
+					{
+						component: new ScrollView(
+							new Text(Array.from({ length: 20 }, (_, i) => `BODY ${i}`).join("\n"), 0, 0),
+						),
+						basis: zeroBasis ? 0 : "auto",
+						grow: 1,
+						shrink: 1,
+						minSize: 0,
+					},
+					{ component: new Text("CLOSE", 0, 0), shrink: 0 },
+				]);
+				const dialog = h.showExtensionCustom(
+					(_tui, _theme, _keys, finish) => {
+						done = finish;
+						return panel;
+					},
+					{ retainEditorBorders: true },
+				);
+				await vi.waitFor(() => expect(h.editorContainer.children).toContain(panel));
+				h.renderer.start();
+				h.renderer.renderNow();
+				await terminal.flush();
+				const screen = terminal.getViewport().join("\n");
+				if (edges > 0) expect(screen).toContain("TOP BADGE");
+				if (edges > 1) expect(screen).toContain("BOTTOM BADGE");
+				expect(screen).toContain("HEADER");
+				expect(screen).toContain("BODY 0");
+				expect(screen).toContain("CLOSE");
+				expect(screen).not.toContain("private draft");
+				for (let i = 0; i < footerRows; i++) expect(screen).toContain(`FOOTER ${i}`);
+				for (let i = 0; i < belowRows; i++) expect(screen).toContain(`BELOW ${i}`);
+				done();
+				await dialog;
+				expect(h.editor.getText()).toBe("private draft");
+			} finally {
+				done();
+				dispose(h);
+			}
+		},
+	);
+});
