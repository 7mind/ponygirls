index 0000000..c7f33fb
--- /dev/null
+++ b/packages/tui/src/components/bounded-v-stack.ts
@@ -0,0 +1,179 @@
+import { getLayoutBoxesAt, type LayoutBox, type LayoutFrame, type LayoutRect, renderLayoutFrame } from "../layout.ts";
+import { getLayoutNode, LAYOUT_NODE, type StackLayoutNode } from "../layout-node.ts";
+import { Container, dispatchMouseEvent, type TuiMouseDispatchResult, type TuiMouseEvent } from "../tui.ts";
+import { allocateStackSizes, visibleStackEntries } from "./stack.ts";
+import { VStack } from "./v-stack.ts";
+
+export interface BoundedVStackOptions {
+	/** Undefined preserves ordinary intrinsic rendering, including measurement by a structural host. */
+	getMaxHeight(width: number): number | undefined;
+	requestRender(): void;
+}
+
+/** A stack that can allocate its structural descendants within a flat-rendered host. */
+export class BoundedVStack extends VStack {
+	private readonly options: BoundedVStackOptions;
+	private frame: LayoutFrame | undefined;
+	private layoutToken: object | undefined;
+	private allocatedNode: StackLayoutNode | undefined;
+	private dispatchHeights = new Map<LayoutBox, number>();
+
+	constructor(options: BoundedVStackOptions) {
+		super();
+		this.options = options;
+	}
+
+	override [LAYOUT_NODE](): StackLayoutNode {
+		return this.allocatedNode ?? super[LAYOUT_NODE]();
+	}
+
+	protected override get mouseLayoutToken(): object | undefined {
+		return this.layoutToken;
+	}
+
+	override clear(): void {
+		super.clear();
+		this.frame = undefined;
+		this.layoutToken = undefined;
+		this.dispatchHeights.clear();
+	}
+
+	override render(width: number): string[] {
+		const limit = this.options.getMaxHeight(width);
+		if (limit === undefined) {
+			this.frame = undefined;
+			this.layoutToken = undefined;
+			this.dispatchHeights.clear();
+			// Structural hosts skip this exact inherited handler after visiting the descendants themselves.
+			this.handleMouse = Container.prototype.handleMouse;
+			return super.render(width);
+		}
+		this.handleMouse = this.handleBoundedMouse;
+		const available = Math.max(0, Math.floor(limit));
+		if (available === 0) {
+			this.frame = undefined;
+			this.layoutToken = undefined;
+			this.dispatchHeights.clear();
+			return [];
+		}
+		const node = super[LAYOUT_NODE]();
+		const viewport = { width, height: available };
+		const entries = visibleStackEntries(node.entries, viewport).map((entry) => {
+			if (entry.grow !== undefined || entry.shrink === 0 || typeof entry.basis === "number") return entry;
+			const child = getLayoutNode(entry.component);
+			// An auto-sized slot passes its child's explicit vertical fill into the finite allocation.
+			if (
+				child?.type === "vstack" &&
+				visibleStackEntries(child.entries, viewport).some((item) => (item.grow ?? 0) > 0)
+			) {
+				return { ...entry, grow: 1 };
+			}
+			return entry;
+		});
+		const sizes = allocateStackSizes(
+			entries,
+			entries.map((entry) => entry.component.render(width).length),
+			available,
+			node.gap,
+		);
+		const height = Math.min(
+			available,
+			sizes.reduce((sum, size) => sum + size, 0) + Math.max(0, entries.length - 1) * node.gap,
+		);
+		if (height === 0) {
+			this.frame = undefined;
+			this.layoutToken = undefined;
+			this.dispatchHeights.clear();
+			return [];
+		}
+		let frame: LayoutFrame;
+		this.allocatedNode = { ...node, entries };
+		try {
+			frame = renderLayoutFrame(this, width, height, this.options.requestRender);
+		} finally {
+			this.allocatedNode = undefined;
+		}
+		// Snapshot source bounds: render() may return a line array that is later mutated in place.
+		const heights = new Map<LayoutBox, number>();
+		const rememberHeight = (box: LayoutBox): void => {
+			heights.set(box, Math.max(box.rect.height, box.lines?.length ?? 0));
+			box.children.forEach(rememberHeight);
+		};
+		rememberHeight(frame.root);
+		if (!this.frame || !sameLayout(this.frame.root, frame.root, this.dispatchHeights, heights)) this.layoutToken = {};
+		this.frame = frame;
+		this.dispatchHeights = heights;
+		return frame.lines;
+	}
+
+	private handleBoundedMouse(event: TuiMouseEvent): TuiMouseDispatchResult | undefined {
+		const frame = this.frame;
+		const token = this.layoutToken;
+		const heights = this.dispatchHeights;
+		if (!frame || !token) return undefined;
+		const visited = new Set<LayoutBox["component"]>();
+		for (const box of getLayoutBoxesAt(frame, event.x, event.y)) {
+			if (box.component === this || visited.has(box.component)) continue;
+			if (getLayoutNode(box.component) && box.component.handleMouse === Container.prototype.handleMouse) continue;
+			visited.add(box.component);
+			if (!this.isLive(box, token)) continue;
+			const result = dispatchMouseEvent(box.component, {
+				...event,
+				x: event.x - box.rect.x,
+				y: event.y - box.rect.y + (box.lineOffset ?? 0),
+				width: box.rect.width,
+				height: heights.get(box)!,
+			});
+			if (!result) continue;
+			const valid = result.target.isValid;
+			result.target = { ...result.target, isValid: () => this.isLive(box, token) && (valid?.() ?? true) };
+			if (result.focus) {
+				for (let parent = box.parent; parent; parent = parent.parent) {
+					if (parent.component.handleInput) result.focusTarget = parent.component;
+				}
+			}
+			return result;
+		}
+		return undefined;
+	}
+
+	private isLive(box: LayoutBox, token: object): boolean {
+		const frame = this.frame;
+		if (!frame || this.layoutToken !== token) return false;
+		let child = box;
+		while (child.parent) {
+			const parent = child.parent;
+			const node = getLayoutNode(parent.component);
+			if (!node) return false;
+			if (node.type === "scroll") {
+				if (node.component !== child.component || node.state.scrollTop !== parent.rect.y - child.rect.y)
+					return false;
+			} else if (!visibleStackEntries(node.entries, frame).some((entry) => entry.component === child.component)) {
+				return false;
+			}
+			child = parent;
+		}
+		return child.component === this;
+	}
+}
+
+function sameRect(a: LayoutRect, b: LayoutRect): boolean {
+	return a.x === b.x && a.y === b.y && a.width === b.width && a.height === b.height;
+}
+
+function sameLayout(
+	a: LayoutBox,
+	b: LayoutBox,
+	aHeights: ReadonlyMap<LayoutBox, number>,
+	bHeights: ReadonlyMap<LayoutBox, number>,
+): boolean {
+	return (
+		a.component === b.component &&
+		sameRect(a.rect, b.rect) &&
+		sameRect(a.clip, b.clip) &&
+		a.lineOffset === b.lineOffset &&
+		aHeights.get(a) === bHeights.get(b) &&
+		a.children.length === b.children.length &&
+		a.children.every((child, index) => sameLayout(child, b.children[index]!, aHeights, bHeights))
+	);
+}
