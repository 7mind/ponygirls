+describe("OAuth 401 forced refresh", () => {
+	it.each(["none", "stream", "auth"])("refreshes only the unchanged failed token (rotation=%s)", async (rotation) => {
+		const rotated = rotation !== "none";
+		const credentials = new InMemoryCredentialStore();
+		const credential = { type: "oauth" as const, access: "failed", refresh: "r", expires: Date.now() + 3_600_000 };
+		await credentials.modify("p1", async () => credential);
+		const refresh = vi.fn(async () => ({ ...credential, access: "refreshed" }));
+		const provider = testProvider({
+			id: "p1",
+			auth: {
+				oauth: testOAuth({
+					refresh,
+					toAuth: async (resolved) => {
+						if (rotation === "auth" && resolved.access === "failed") {
+							await credentials.modify("p1", async () => ({ ...credential, access: "rotated" }));
+						}
+						return { apiKey: resolved.access };
+					},
+				}),
+			},
+		});
+		const keys: Array<string | undefined> = [];
+		provider.stream = provider.streamSimple = (model, _context, options) => {
+			keys.push(options?.apiKey);
+			const stream = new AssistantMessageEventStream();
+			void (async () => {
+				const message = doneMessage(model, "ok");
+				if (keys.length === 1) {
+					if (rotation === "stream")
+						await credentials.modify("p1", async () => ({ ...credential, access: "rotated" }));
+					message.stopReason = "error";
+					message.errorMessage = "401 Unauthorized";
+					stream.push({ type: "error", reason: "error", error: message });
+				} else stream.push({ type: "done", reason: "stop", message });
+				stream.end(message);
+			})();
+			return stream;
+		};
+		const models = createModels({ credentials });
+		models.setProvider(provider);
+		expect((await models.completeSimple(testModel("p1", "model-a"), context)).stopReason).toBe("stop");
+		expect(keys).toEqual(["failed", rotated ? "rotated" : "refreshed"]);
+		expect(refresh).toHaveBeenCalledTimes(rotated ? 0 : 1);
+	});
+});
+
+describe("OAuth 401 auth-source rotation", () => {
+	it.each(["oauth", "api_key"])(
+		"classifies the resolved credential, not an earlier read (%s)",
+		async (initialType) => {
+			const backing = new InMemoryCredentialStore();
+			const oauth = { type: "oauth" as const, access: "oauth", refresh: "r", expires: Date.now() + 3_600_000 };
+			const staticKey = { type: "api_key" as const, key: "static" };
+			await backing.modify("p1", async () => (initialType === "oauth" ? oauth : staticKey));
+			let firstRead = true;
+			const credentials: CredentialStore = {
+				read: async (...args) => {
+					const read = await backing.read(...args);
+					if (firstRead) {
+						firstRead = false;
+						await backing.modify("p1", async () => (initialType === "oauth" ? staticKey : oauth));
+					}
+					return read;
+				},
+				modify: (...args) => backing.modify(...args),
+				list: (...args) => backing.list(...args),
+				delete: (...args) => backing.delete(...args),
+			};
+			const provider = testProvider({ id: "p1", auth: { oauth: testOAuth(), apiKey: envKeyAuth(undefined) } });
+			const keys: Array<string | undefined> = [];
+			provider.stream = provider.streamSimple = (model, _context, options) => {
+				keys.push(options?.apiKey);
+				const stream = new AssistantMessageEventStream();
+				const message = doneMessage(model, "ok");
+				if (keys.length === 1) {
+					message.stopReason = "error";
+					message.errorMessage = "401 Unauthorized";
+					stream.push({ type: "error", reason: "error", error: message });
+				} else stream.push({ type: "done", reason: "stop", message });
+				stream.end(message);
+				return stream;
+			};
+			const models = createModels({ credentials });
+			models.setProvider(provider);
+			const response = await models.completeSimple(testModel("p1", "model-a"), context);
+			// Only the auth used for the failed request determines eligibility.
+			expect(keys.length).toBe(keys[0] === "oauth" ? 2 : 1);
+			expect(response.stopReason).toBe(keys[0] === "oauth" ? "stop" : "error");
+		},
+	);
+});
