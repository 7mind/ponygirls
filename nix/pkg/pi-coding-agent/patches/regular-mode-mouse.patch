@@ -0,0 +1,76 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { CursorPositionProbe } from "../src/cursor-position.ts";
+import { VirtualTerminal } from "./virtual-terminal.ts";
+
+describe("cursor-position wire ownership", () => {
+	it("retains only a tombstone when the owner cancels", () => {
+		const terminal = new VirtualTerminal();
+		const probe = new CursorPositionProbe(terminal);
+		let oldReplies = 0;
+		let oldWakeups = 0;
+		let newWakeups = 0;
+		const reply = () => {
+			oldReplies++;
+		};
+		const idle = () => {
+			oldWakeups++;
+		};
+		probe.listen(idle);
+		assert.equal(probe.request(reply), true);
+		probe.cancel(reply);
+		probe.unlisten(idle);
+		probe.listen(() => {
+			newWakeups++;
+		});
+		assert.equal(
+			probe.request(() => {}),
+			false,
+		);
+		assert.equal(probe.consume("\x1b[3;1R"), true);
+		assert.equal(oldReplies, 0);
+		assert.equal(oldWakeups, 0);
+		assert.equal(newWakeups, 1);
+		assert.equal(
+			probe.request(() => {}),
+			true,
+		);
+	});
+
+	it("does not let a nonmatching modified-F3 report release the pending query", () => {
+		const probe = new CursorPositionProbe(new VirtualTerminal());
+		let replies = 0;
+		probe.request(() => {
+			replies++;
+		});
+		assert.equal(probe.consume("\x1b[1;2R"), false);
+		assert.equal(
+			probe.request(() => {}),
+			false,
+		);
+		assert.equal(replies, 0);
+		assert.equal(probe.consume("\x1b[2;1R"), true);
+		assert.equal(replies, 1);
+	});
+
+	it("restores the cursor column, including a one-column terminal", async () => {
+		for (const width of [1, 40]) {
+			const terminal = new VirtualTerminal(width, 12);
+			terminal.write(`\x1b[3;${width}H`);
+			await terminal.flush();
+			const before = terminal.getCursorPosition();
+			new CursorPositionProbe(terminal).request(() => {});
+			await terminal.flush();
+			assert.deepEqual(terminal.getCursorPosition(), before);
+		}
+	});
+
+	it("does not add a row when the caller settles pending wrap before probing", async () => {
+		const terminal = new VirtualTerminal(5, 12);
+		terminal.write("12345\r");
+		new CursorPositionProbe(terminal).request(() => {});
+		terminal.write("\r\nX");
+		await terminal.flush();
+		assert.deepEqual(terminal.getViewport().slice(0, 2), ["12345", "X"]);
+	});
+});
