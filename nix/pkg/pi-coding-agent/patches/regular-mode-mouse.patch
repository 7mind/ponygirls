+			assert.equal(control.events.at(-1)?.y, 0);
+		}
+		assert.equal(control.events.filter((event) => event.type === "click").length, 50);
+		assert.equal(terminal.writes.filter((write) => write.includes("\x1b[6n")).length, before);
+	});
+
+	it("does not assign a stopped renderer's reply to a new regular instance", async (t) => {
+		const terminal = new MouseTerminal(40, 12);
+		const old = new TuiMainScreen(terminal, false, undefined, { mouse: true });
+		old.addChild(new Control());
+		old.start();
