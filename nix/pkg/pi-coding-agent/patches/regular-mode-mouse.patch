diff --git a/packages/coding-agent/test/regular-mouse-settings.test.ts b/packages/coding-agent/test/regular-mouse-settings.test.ts
new file mode 100644
index 0000000..eafba39
--- /dev/null
+++ b/packages/coding-agent/test/regular-mouse-settings.test.ts
@@ -0,0 +1,80 @@
+import { Text } from "@earendil-works/pi-tui";
+import { describe, expect, it } from "vitest";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal.ts";
+import { InMemorySettingsStorage, SettingsManager } from "../src/core/settings-manager.ts";
+import { SettingsSchema } from "../src/core/settings-schema.ts";
+import { createInteractiveTui } from "../src/modes/interactive/tui-renderer.ts";
+
+class RecordingTerminal extends VirtualTerminal {
+	readonly writes: string[] = [];
+	override write(data: string): void {
+		this.writes.push(data);
+		super.write(data);
+	}
+}
+
+describe("regularMouse settings and renderer composition", () => {
+	it("defaults to off without changing the default fullscreen mode", () => {
+		const settings = SettingsManager.inMemory();
+		expect(settings.getRegularMouse()).toBe(false);
+		expect(settings.getTuiMode()).toBe("fullscreen");
+		expect(SettingsSchema.properties.regularMouse).toMatchObject({ default: false });
+	});
+
+	it("allows a trusted project override and ignores an untrusted override", () => {
+		const storage = new InMemorySettingsStorage();
+		storage.withLock("global", () => JSON.stringify({ regularMouse: true }));
+		storage.withLock("project", () => JSON.stringify({ regularMouse: false }));
+		expect(SettingsManager.fromStorage(storage).getRegularMouse()).toBe(false);
+		expect(SettingsManager.fromStorage(storage, { projectTrusted: false }).getRegularMouse()).toBe(true);
+	});
+
+	it("requires an explicit boolean true at the settings-file boundary", () => {
+		const storage = new InMemorySettingsStorage();
+		storage.withLock("global", () => JSON.stringify({ regularMouse: "true" }));
+		expect(SettingsManager.fromStorage(storage).getRegularMouse()).toBe(false);
+	});
+
+	it.each([true, false])("wires regularMouse=%s without entering the alternate screen", async (enabled) => {
+		const terminal = new RecordingTerminal();
+		const settings = SettingsManager.inMemory({ regularMouse: enabled });
+		const tui = createInteractiveTui({
+			tuiMode: "regular",
+			showHardwareCursor: false,
+			logDirectory: "/tmp",
+			terminal,
+			regularMouse: settings.getRegularMouse(),
+		});
+		tui.addChild(new Text("control", 0, 0));
+		tui.start();
+		try {
+			tui.renderNow();
+			await terminal.flush();
+			const output = terminal.writes.join("");
+			expect(output.includes("\x1b[?1000h")).toBe(enabled);
+			expect(output.includes("\x1b[6n")).toBe(enabled);
+			expect(output.includes("\x1b[?1049h")).toBe(false);
+		} finally {
+			tui.stop();
+		}
+	});
+
+	it("does not disable fullscreen mouse capture when regularMouse is off", async () => {
+		const terminal = new RecordingTerminal();
+		const tui = createInteractiveTui({
+			tuiMode: "fullscreen",
+			showHardwareCursor: false,
+			logDirectory: "/tmp",
+			terminal,
+			regularMouse: false,
+		});
+		tui.start();
+		try {
+			tui.renderNow();
+			await terminal.flush();
+			expect(terminal.writes.join("")).toContain("\x1b[?1000h");
+		} finally {
+			tui.stop();
+		}
+	});
+});
