+				}
+			}
+			return;
+		}
+		const generation = this.generation;
+		const result = this.dispatch(event);
+		if (!this.active || generation !== this.generation || result?.target.isValid?.() === false) return;
+		if (!result) {
+			if (event.type === "press") this.lastClick = undefined;
+			return;
+		}
+		if (event.type === "press") {
+			this.press = {
