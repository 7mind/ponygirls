+import assert from "node:assert/strict";
+import { describe, it, type TestContext } from "node:test";
+import { Box } from "../src/components/box.ts";
+import { StdinBuffer } from "../src/stdin-buffer.ts";
+import { type Component, Container, CURSOR_MARKER, type TuiMouseEvent } from "../src/tui.ts";
+import { TuiAltScreen } from "../src/tui-alt-screen.ts";
+import { TuiMainScreen } from "../src/tui-main-screen.ts";
+import { VirtualTerminal } from "./virtual-terminal.ts";
+
+class MouseTerminal extends VirtualTerminal {
+	writes: string[] = [];
+	override write(data: string): void {
+		this.writes.push(data);
+		super.write(data);
+	}
+
+	async replyPosition(): Promise<void> {
+		await this.flush();
+		const cursor = this.getCursorPosition();
+		this.sendInput(`\x1b[${cursor.y + 1};1R`);
+	}
+}
+
+class Control implements Component {
+	lines = ["button"];
+	events: TuiMouseEvent[] = [];
+	keys: string[] = [];
+	onMouse: ((event: TuiMouseEvent) => void) | undefined;
+	render(): string[] {
+		return this.lines;
+	}
+	handleMouse(event: TuiMouseEvent) {
+		this.events.push(event);
+		this.onMouse?.(event);
+		return { handled: true, focus: true };
+	}
+	handleInput(data: string): void {
+		this.keys.push(data);
+	}
+	invalidate(): void {}
+}
+
+function click(terminal: MouseTerminal, x: number, y: number): void {
+	terminal.sendInput(`\x1b[<0;${x + 1};${y + 1}M`);
+	terminal.sendInput(`\x1b[<0;${x + 1};${y + 1}m`);
+}
+
+async function harness(t: TestContext) {
+	const terminal = new MouseTerminal(40, 12);
+	const tui = new TuiMainScreen(terminal, false, undefined, { mouse: true });
+	const control = new Control();
+	tui.addChild(control);
+	tui.setFocus(control);
+	tui.start();
+	t.after(() => tui.stop());
+	tui.renderNow();
+	await terminal.replyPosition();
+	return { terminal, tui, control };
+}
+
+// Behavioral, blackbox-group: real renderer and components against a terminal emulator.
+describe("regular-mode mouse", () => {
+	it("does not apply a click result across a renderer restart", async (t) => {
+		const { terminal, tui, control } = await harness(t);
+		control.onMouse = (event) => {
+			if (event.type !== "click") return;
+			tui.stop({ preserveScreen: true });
+			tui.setFocus(null);
+			tui.start();
+			tui.renderNow(true);
+		};
+		click(terminal, 1, 0);
+		assert.equal(tui.getFocusedComponent(), null);
+	});
+
+	it("tracks append and shrink after shell output without a resize", async () => {
+		const terminal = new MouseTerminal(40, 12);
+		terminal.write("shell\r\n".repeat(7));
+		const tui = new TuiMainScreen(terminal, false, undefined, { mouse: true });
+		const control = new Control();
+		control.lines = ["line 0"];
+		tui.addChild(control);
+		tui.start();
+		try {
+			tui.renderNow();
+			await terminal.replyPosition();
+			for (const count of [3, 8, 15, 20, 18, 12, 2]) {
+				control.lines = Array.from({ length: count }, (_, index) => `line ${index}`);
+				tui.renderNow();
+				await terminal.flush();
+				const viewport = terminal.getViewport();
+				for (const [row, line] of viewport.entries()) {
+					const match = /^line (\d+)$/.exec(line);
+					if (!match) continue;
+					click(terminal, 1, row);
+					assert.equal(control.events.at(-1)?.y, Number(match[1]));
+				}
+			}
+		} finally {
+			tui.stop();
+		}
+	});
+	it("maps an overlay after a non-clearing shrink to its committed physical row", async (t) => {
