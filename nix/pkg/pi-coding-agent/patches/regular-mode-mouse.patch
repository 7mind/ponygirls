+	}
+
+	private handle(event: TuiMouseEvent): void {
+		if (event.type === "press") this.press = undefined;
+		const press = this.press;
+		if (event.type === "release" || event.type === "drag") {
+			if (!press || press.button !== event.button || press.target.isValid?.() === false) {
+				this.clearGesture();
+				return;
+			}
