@@ -0,0 +1,46 @@
+import type { Terminal } from "./terminal.ts";
+
+const POSITION_QUERY = "\x1b7\x1b[1G\x1b[6n\x1b8";
+
+/** Serializes untagged cursor reports across renderers sharing one terminal. */
+export class CursorPositionProbe {
+	private readonly terminal: Terminal;
+	private pending: { reply: ((row: number) => void) | undefined } | undefined;
+	private whenIdle: (() => void) | undefined;
+
+	constructor(terminal: Terminal) {
+		this.terminal = terminal;
+	}
+
+	listen(whenIdle: () => void): void {
+		this.whenIdle = whenIdle;
+	}
+
+	unlisten(whenIdle: () => void): void {
+		if (this.whenIdle === whenIdle) this.whenIdle = undefined;
+	}
+
+	cancel(reply: (row: number) => void): void {
+		if (this.pending?.reply === reply) this.pending.reply = undefined;
