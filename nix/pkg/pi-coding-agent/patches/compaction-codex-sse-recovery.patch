+import { once } from "node:events";
+import { createServer, type Server } from "node:http";
+import type { AddressInfo } from "node:net";
+import { closeOpenAICodexWebSocketSessions, streamSimple } from "@earendil-works/pi-ai/api/openai-codex-responses";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { WebSocketServer } from "ws";
+import {
+	codexModel,
+	syntheticContext,
+	syntheticSseResponse,
+	syntheticToken,
+} from "../../ai/test/fixtures/codex-websocket.ts";
+import { completeSummarization } from "../src/core/compaction/compaction.ts";
+
+let server: Server;
+let sockets: WebSocketServer;
+let baseUrl: string;
+let websocketRequests: number;
+let httpRequests: number;
+
+beforeEach(async () => {
+	websocketRequests = 0;
+	httpRequests = 0;
+	const sse = await syntheticSseResponse("Recovered over HTTP").text();
+	const completeEvents = sse
+		.trim()
+		.split("\n\n")
+		.map((line) => line.slice("data: ".length));
+	server = createServer((request, response) => {
+		httpRequests++;
+		request.resume();
+		response.writeHead(200, { "content-type": "text/event-stream" });
+		response.end(sse);
+	});
+	sockets = new WebSocketServer({ server });
+	sockets.on("connection", (socket) => {
+		socket.on("message", () => {
+			websocketRequests++;
+			socket.send(JSON.stringify({ type: "response.created", response: { id: "created", status: "in_progress" } }));
+			if (websocketRequests === 1) {
+				for (const event of completeEvents.slice(0, 3)) socket.send(event);
+				socket.close(1011, "synthetic_disconnect");
+			} else {
+				for (const event of completeEvents) socket.send(event);
+			}
+		});
+	});
+	server.listen(0, "127.0.0.1");
+	await once(server, "listening");
+	baseUrl = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+});
+
+afterEach(async () => {
+	closeOpenAICodexWebSocketSessions();
+	for (const socket of sockets.clients) socket.terminate();
+	await new Promise<void>((resolve, reject) => sockets.close((error) => (error ? reject(error) : resolve())));
+	server.closeAllConnections();
+	await new Promise<void>((resolve, reject) => server.close((error) => (error ? reject(error) : resolve())));
+});
+
+describe("Codex summary recovery over loopback transports", () => {
+	it.each([
+		{ transport: "auto", expectedWebsocketRequests: 1, expectedHttpRequests: 1 },
+		{ transport: "sse", expectedWebsocketRequests: 0, expectedHttpRequests: 1 },
+		{ transport: "websocket", expectedWebsocketRequests: 2, expectedHttpRequests: 0 },
+	] as const)(
+		"preserves $transport policy using real sockets",
+		async ({ transport, expectedWebsocketRequests, expectedHttpRequests }) => {
+			const model = { ...codexModel, baseUrl };
+			const result = await completeSummarization(
+				model,
+				syntheticContext(),
+				{ apiKey: syntheticToken(), transport, signal: AbortSignal.timeout(5000), timeoutMs: 2000 },
+				(requestModel, context, options) =>
+					streamSimple({ ...requestModel, api: "openai-codex-responses" }, context, options),
+				{ enabled: true, maxRetries: 1, baseDelayMs: 1, maxAgentDelayMs: 1 },
