+			expect(result.content).toEqual([expect.objectContaining({ type: "text", text: "Recovered over HTTP" })]);
+			expect(websocketRequests).toBe(expectedWebsocketRequests);
+			expect(httpRequests).toBe(expectedHttpRequests);
+		},
+	);
