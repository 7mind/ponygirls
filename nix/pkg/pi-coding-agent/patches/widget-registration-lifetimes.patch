diff --git a/packages/coding-agent/test/interactive-widget-reconciliation.test.ts b/packages/coding-agent/test/interactive-widget-reconciliation.test.ts
new file mode 100644
index 0000000..c6b4698
--- /dev/null
+++ b/packages/coding-agent/test/interactive-widget-reconciliation.test.ts
@@ -0,0 +1,269 @@
+import {
+	type Component,
+	type Container,
+	Spacer,
+	type TUI,
+	TuiAltScreen,
+	type TuiMainScreen,
+	type TuiMouseEvent,
+	VStack,
+} from "@earendil-works/pi-tui";
+import { describe, expect, it, vi } from "vitest";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal.ts";
+import type { AgentSessionRuntime } from "../src/core/agent-session-runtime.ts";
+import type { EditorFactory, ExtensionWidgetOptions } from "../src/core/extensions/types.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { SettingsManager } from "../src/core/settings-manager.ts";
+import type { CustomEditor, EditorBorderContent } from "../src/modes/interactive/components/custom-editor.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+
+const WIDTH = 120;
+const HEIGHT = 36;
+const AGENTS = "AGENTS stable";
+const OTHER = "OTHER stable";
+const CASES = [
+	"unchanged-render",
+	"unrelated-publication",
+	"same-row-publication",
+	"synchronous-publication",
+	"clicked-replacement",
+	"moving-geometry",
+	"revision-only",
+	"editor-replacement",
+	"above-own-republication",
+	"below-own-republication",
+	"above-keyboard-routing",
+	"above-synchronous-republication",
+] as const;
+const MODES = [
+	["regular", false],
+	["regular", true],
+	["fullscreen", false],
+	["fullscreen", true],
+] as const;
+type Host = {
+	renderer: TuiMainScreen | TuiAltScreen;
+	editor: CustomEditor;
+	editorContainer: VStack;
+	widgetContainerAbove: Container;
+	widgetContainerBelow: Container;
+	footerContainer: Container;
+	extensionWidgets: Map<string, { component: Component; borderContent: EditorBorderContent }>;
+	programStatus: { setBlocked: ReturnType<typeof vi.fn> };
+	themeController: { dispose(): void };
+	footer: { dispose(): void };
+	footerDataProvider: { dispose(): void };
+	setExtensionWidget(key: string, factory: (() => Component) | undefined, options: ExtensionWidgetOptions): void;
+	setCustomEditorComponent(factory: EditorFactory | undefined): void;
+	showExtensionCustom(
+		factory: (tui: TUI, theme: unknown, keys: unknown, done: () => void) => Component,
+		options: { retainEditorBorders: boolean },
+	): Promise<void>;
+};
+
+// Regression: unrelated publication must not revoke the pressed widget's registration or ancestor layout.
+describe.each(MODES)("widget reconciliation (%s, retained: %s)", (mode, retained) => {
+	it.each([...CASES, ...(mode === "regular" ? ["ancestor-replacement-cancellation-control" as const] : [])])(
+		"%s",
+		async (scenario) => {
+			const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+			const runtime = {
+				session: {
+					settingsManager: SettingsManager.inMemory({ tuiMode: mode, regularMouse: true, theme: "dark" }),
+					sessionManager: SessionManager.inMemory("/tmp"),
+					autoCompactionEnabled: false,
+					resourceLoader: { getThemes: () => ({ themes: [] }) },
+				},
+				setBeforeSessionInvalidate: () => {},
+				setRebindSession: () => {},
+			};
+			// Only constructor dependencies are synthetic; widget publication, rendering and input routing are production code.
+			const h = new InteractiveMode(runtime as unknown as AgentSessionRuntime, { terminal }) as unknown as Host;
+			h.programStatus = { setBlocked: vi.fn() };
+			const events: string[] = [];
+			const replacementEvents: string[] = [];
+			const otherPlacement = scenario === "same-row-publication" ? "borderBottomLeft" : "borderTopRight";
+			const other = () => ({ render: () => [OTHER], invalidate() {} });
+			let leadRows = 1;
+			let done: () => void = () => {};
+			let dialog: Promise<void> | undefined;
+			try {
+				h.footerContainer.clear();
+				const root = new VStack([
+					{
+						component: { render: () => Array.from({ length: leadRows }, () => "LEAD"), invalidate() {} },
+						shrink: 0,
+					},
+					{ component: h.widgetContainerAbove, shrink: 0 },
+					{ component: h.editorContainer },
+					{ component: h.widgetContainerBelow, shrink: 0 },
+					{ component: h.footerContainer, shrink: 0 },
+				]);
+				if (h.renderer instanceof TuiAltScreen) h.renderer.setLayoutRoot(root);
+				else for (const component of root.children) h.renderer.addChild(component);
+				h.editor.setText("unsent draft");
+				const input: string[] = [];
+				let disposedAbove = 0;
+				const receive = (event: TuiMouseEvent) => {
+					events.push(event.type);
+					if (scenario === "above-synchronous-republication" && event.type === "press")
+						h.setExtensionWidget("above", () => stableAbove, { placement: "aboveEditor" });
+					return { handled: true, focus: scenario === "above-keyboard-routing" };
+				};
+				const stableAbove = {
+					render: () => ["ABOVE"],
+					invalidate() {},
+					handleMouse: receive,
+					handleInput: (data: string) => {
+						input.push(data);
+					},
+					focused: false,
+					dispose: () => {
+						disposedAbove++;
+					},
+				};
+				const stableBelow = { render: () => ["BELOW"], invalidate() {}, handleMouse: receive };
+				h.setExtensionWidget("above", () => stableAbove, { placement: "aboveEditor" });
+				h.setExtensionWidget("below", () => stableBelow, { placement: "belowEditor" });
+				h.setExtensionWidget(
+					"agents",
+					() => ({
+						render: () => [AGENTS],
+						invalidate() {},
+						handleMouse(event: TuiMouseEvent) {
+							events.push(event.type);
+							if (scenario === "synchronous-publication" && event.type === "press") {
+								h.setExtensionWidget("other", other, { placement: otherPlacement });
+								h.renderer.renderNow();
+							}
+							return { handled: true, focus: false };
+						},
+					}),
+					{ placement: "borderBottomLeft" },
+				);
+				h.setExtensionWidget("other", other, { placement: otherPlacement });
+				const agent = h.extensionWidgets.get("agents")!;
+				const above = [...h.widgetContainerAbove.children];
+				const below = [...h.widgetContainerBelow.children];
+				if (retained) {
+					const panel = { render: () => ["PANEL"], invalidate() {} };
+					dialog = h.showExtensionCustom(
+						(_tui, _theme, _keys, finish) => {
+							done = finish;
+							return panel;
+						},
+						{ retainEditorBorders: true },
+					);
+					await vi.waitFor(() => expect(h.editorContainer.children).toContain(panel));
+				}
+				h.renderer.start();
+				h.renderer.renderNow();
+				await terminal.flush();
+				if (mode === "regular") terminal.sendInput(`\x1b[${terminal.getCursorPosition().y + 1};1R`);
+				const before = terminal.getViewport();
+				const clickedLabel =
+					scenario === "above-own-republication" ||
+					scenario === "above-keyboard-routing" ||
+					scenario === "above-synchronous-republication"
+						? "ABOVE"
+						: scenario === "below-own-republication"
+							? "BELOW"
+							: AGENTS;
+				const row = before.findIndex((line) => line.includes(clickedLabel));
+				expect(row).toBeGreaterThanOrEqual(0);
+				const column = before[row].indexOf(clickedLabel) + 1;
+				terminal.sendInput(`\x1b[<0;${column + 1};${row + 1}M`);
+				expect(events).toEqual(["press"]);
+				switch (scenario) {
+					case "unrelated-publication":
+					case "above-keyboard-routing":
+					case "same-row-publication":
+						h.setExtensionWidget("other", other, { placement: otherPlacement });
+						break;
+					case "clicked-replacement":
+						h.setExtensionWidget(
+							"agents",
+							() => ({
+								render: () => [AGENTS],
+								invalidate() {},
+								handleMouse(event) {
+									replacementEvents.push(event.type);
+									return { handled: true };
+								},
+							}),
+							{ placement: "borderBottomLeft" },
+						);
+						break;
+					case "above-own-republication":
+						h.setExtensionWidget("above", () => stableAbove, { placement: "aboveEditor" });
+						break;
+					case "below-own-republication":
+						h.setExtensionWidget("below", () => stableBelow, { placement: "belowEditor" });
+						break;
+					case "moving-geometry":
+						leadRows = 2;
+						break;
+					case "revision-only":
+						h.editor.setBorderContent("topRight", "other", { render: () => OTHER });
+						break;
+					case "editor-replacement":
+						h.setCustomEditorComponent(() => h.editor);
+						break;
+					case "ancestor-replacement-cancellation-control":
+						h.widgetContainerAbove.children[0] = new Spacer(1);
+						break;
+				}
+				h.renderer.renderNow();
+				await terminal.flush();
+				const after = terminal.getViewport();
+				terminal.sendInput(`\x1b[<0;${column + 1};${row + 1}m`);
+				const cancelled =
+					scenario === "clicked-replacement" ||
+					scenario === "moving-geometry" ||
+					scenario === "editor-replacement" ||
+					scenario === "above-own-republication" ||
+					scenario === "above-synchronous-republication" ||
+					scenario === "below-own-republication" ||
+					scenario === "ancestor-replacement-cancellation-control";
+				expect(events).toEqual(cancelled ? ["press"] : ["press", "release", "click"]);
+				expect(replacementEvents).toEqual([]);
+				expect(disposedAbove).toBe(
+					scenario === "above-own-republication" || scenario === "above-synchronous-republication" ? 1 : 0,
+				);
+				if (scenario === "above-keyboard-routing") {
+					expect(h.renderer.getFocusedComponent()).toBe(stableAbove);
+					terminal.sendInput("z");
+					expect(input).toEqual(["z"]);
+				}
+				if (scenario === "moving-geometry") expect(after.findIndex((line) => line.includes(AGENTS))).toBe(row + 1);
+				else expect(after).toEqual(before);
+				if (scenario !== "clicked-replacement") expect(h.extensionWidgets.get("agents")).toBe(agent);
+				if (
+					scenario !== "ancestor-replacement-cancellation-control" &&
+					scenario !== "above-own-republication" &&
+					scenario !== "above-synchronous-republication"
+				) {
+					expect(h.widgetContainerAbove.children).toHaveLength(above.length);
+					above.forEach((component, index) => {
+						expect(h.widgetContainerAbove.children[index]).toBe(component);
+					});
+				}
+				expect(h.widgetContainerBelow.children).toHaveLength(below.length);
+				if (scenario !== "below-own-republication")
+					below.forEach((component, index) => {
+						expect(h.widgetContainerBelow.children[index]).toBe(component);
+					});
+				done();
+				if (dialog) await dialog;
+				expect(h.editor.getText()).toBe("unsent draft");
+			} finally {
+				done();
+				h.renderer.stop();
+				h.themeController.dispose();
+				h.footer.dispose();
+				h.footerDataProvider.dispose();
+				await terminal.flush();
+			}
+		},
+	);
+});
