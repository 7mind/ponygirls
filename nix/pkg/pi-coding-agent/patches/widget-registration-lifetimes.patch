+		}
+	});
+});
+
+it("does not revive a bottom badge after the editor body grows and shrinks", () => {
+	initTheme("dark");
+	const tui = new TuiMainScreen(new VirtualTerminal(WIDTH, HEIGHT), undefined, undefined, { mouse: true });
+	const editor = new CustomEditor(tui, getEditorTheme(), KeybindingsManager.create());
+	const events: string[] = [];
