--- /dev/null
+++ b/packages/coding-agent/test/custom-editor-border-registration.test.ts
@@ -0,0 +1,179 @@
+import { type Component, TuiMainScreen, type TuiMouseEvent } from "@earendil-works/pi-tui";
+import { describe, expect, it } from "vitest";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal.ts";
+import { KeybindingsManager } from "../src/core/keybindings.ts";
+import { CustomEditor, type EditorBorderContent } from "../src/modes/interactive/components/custom-editor.ts";
+import { getEditorTheme, initTheme } from "../src/modes/interactive/theme/theme.ts";
+
+const WIDTH = 80;
+const HEIGHT = 12;
+const BADGE = "TARGET";
+const CASES = [
+	"unrelated-same-row",
+	"unrelated-cross-slot",
+	"synchronous-unrelated",
+	"own-replacement",
+	"remove-readd",
+	"clear-readd",
+	"move-restore",
+	"mutable-move-restore",
+	"clip-restore",
+	"synchronous-own-release",
+	"synchronous-focus",
+	"same-object-replacement",
+] as const;
+
+describe.each([false, true])("border registration continuity (retained: %s)", (retained) => {
+	it.each(CASES)("%s", (scenario) => {
+		initTheme("dark");
+		const terminal = new VirtualTerminal(WIDTH, HEIGHT);
+		const tui = new TuiMainScreen(terminal, undefined, undefined, { mouse: true });
+		const editor = new CustomEditor(tui, getEditorTheme(), KeybindingsManager.create());
+		const events: string[] = [];
+		const replacements: string[] = [];
+		let prefix = "P";
+		const replacement: EditorBorderContent = {
+			render: () => BADGE,
+			handleMouse: (event) => {
+				replacements.push(event.type);
+				return { handled: true };
+			},
+		};
+		let view: Component;
+		const badge: EditorBorderContent = {
+			render: () => BADGE,
+			handleMouse(event) {
+				events.push(event.type);
+				if (event.type === "press" && scenario === "synchronous-unrelated") {
+					editor.setBorderContent("bottomRight", "other", { render: () => "OTHER" });
+					view.render(WIDTH);
+				}
+				if (event.type === "press" && scenario === "synchronous-focus") editor.focused = !editor.focused;
+				if (event.type === "release" && scenario === "synchronous-own-release")
+					editor.setBorderContent("topLeft", "badge", replacement);
+				return { handled: true, focus: false };
+			},
+		};
+		editor.setBorderContent("topLeft", "prefix", { render: () => prefix });
+		editor.setBorderContent("topLeft", "badge", badge);
+		editor.setText("draft");
+		view = retained ? editor.createBorderComponent("top", () => true) : editor;
+		try {
+			const before = view.render(WIDTH);
+			const x = before[0].replace(/\x1b\[[0-9;]*m/g, "").indexOf(BADGE);
+			expect(x).toBeGreaterThan(0);
+			const send = (type: TuiMouseEvent["type"]) =>
+				view.handleMouse!({
+					type,
+					button: "left",
+					x,
+					y: 0,
+					screenX: x,
+					screenY: 0,
+					width: WIDTH,
+					height: before.length,
+					shift: false,
+					alt: false,
+					ctrl: false,
+				});
+			send("press");
+			expect(events).toEqual(["press"]);
+			switch (scenario) {
+				case "unrelated-same-row":
+					editor.setBorderContent("topLeft", "prefix", { render: () => "P" });
+					break;
+				case "unrelated-cross-slot":
+					editor.setBorderContent("bottomRight", "other", { render: () => "OTHER" });
+					break;
+				case "own-replacement":
+					editor.setBorderContent("topLeft", "badge", replacement);
+					break;
+				case "same-object-replacement":
+					editor.setBorderContent("topLeft", "badge", badge);
+					break;
+				case "remove-readd":
+					editor.setBorderContent("topLeft", "badge", undefined);
+					editor.setBorderContent("topLeft", "badge", badge);
+					break;
+				case "clear-readd":
+					editor.clearBorderContent();
+					editor.setBorderContent("topLeft", "prefix", { render: () => "P" });
+					editor.setBorderContent("topLeft", "badge", badge);
+					break;
+				case "move-restore":
+					editor.setBorderContent("topLeft", "prefix", { render: () => "LONG PREFIX" });
+					view.render(WIDTH);
+					editor.setBorderContent("topLeft", "prefix", { render: () => "P" });
+					break;
+				case "mutable-move-restore":
+					prefix = "LONG PREFIX";
+					view.render(WIDTH);
+					prefix = "P";
+					break;
+				case "clip-restore":
+					view.render(8);
+					break;
+			}
+			view.render(WIDTH);
+			send("release");
+			send("click");
+			const survives =
+				scenario === "unrelated-same-row" ||
+				scenario === "unrelated-cross-slot" ||
+				scenario === "synchronous-unrelated";
+			expect(events).toEqual(
+				survives
+					? ["press", "release", "click"]
+					: scenario === "synchronous-own-release"
+						? ["press", "release"]
+						: ["press"],
+			);
