+/** Linux ownership is an OS open-file-description flock, never PID liveness.
+ * Sidecars are permanent: unlinking one would create a second lock domain.
+ */
+import * as fs from 'fs';
+import * as path from 'path';
+import { spawnSync } from 'child_process';
+
+export function namespaceIdentity(): string {
+  if (process.platform !== 'linux') return process.platform;
+  // boot ID avoids identifying a recycled namespace inode after reboot.
+  return fs.readFileSync('/proc/sys/kernel/random/boot_id', 'utf8').trim() + ':' +
+    fs.readlinkSync('/proc/self/ns/pid');
+}
+
+export function sameNamespace(value?: string): boolean {
+  if (process.platform !== 'linux') return true;
+  return typeof value === 'string' && value === namespaceIdentity();
+}
+
+const heldLocks = new Map<number, string>();
+export function ownsKernelLock(lockPath: string): boolean {
+  return [...heldLocks.values()].includes(path.resolve(lockPath));
+}
+
+export function tryKernelLock(lockPath: string): number | null {
+  fs.mkdirSync(path.dirname(lockPath), { recursive: true });
+  const fd = fs.openSync(lockPath, 'a+', 0o600);
+  // flock(1) applies flock(2) to inherited FD 3. The parent's descriptor shares
+  // its open-file-description, retaining the lock after this helper exits.
+  const result = spawnSync('@codegraph-flock@', ['-n', '3'], {
+    stdio: ['ignore', 'pipe', 'pipe', fd],
+  });
+  if (result.status === 0) { heldLocks.set(fd, path.resolve(lockPath)); return fd; }
+  fs.closeSync(fd);
+  if (result.status === 1 && !result.error) return null;
+  throw new Error(`CodeGraph kernel lock unavailable (refusing unsafe PID fallback): ${result.error?.message ?? result.stderr?.toString() ?? result.status}`);
+}
+
+export function releaseKernelLock(fd: number): void { heldLocks.delete(fd); fs.closeSync(fd); }
+
+export const LOCK_PROTOCOL = 'flock-v1';
+export function legacyLockMessage(recordPath: string): string {
+  return `CodeGraph legacy/unrecognized ownership record at ${recordPath}. ` +
+    'Refusing automatic PID-based recovery across namespaces. Stop ALL old and new CodeGraph clients, daemons and indexing jobs sharing this checkout; ' +
+    `then, while offline, remove only this record (${recordPath}) and retry. Never remove *.flock sidecars.`;
+}
