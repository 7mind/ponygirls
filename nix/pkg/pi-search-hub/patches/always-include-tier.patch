+/**
+ * Targeted combine always-include tier.
+ *
+ * Free backends are queried beside the quality wave, not as quality slots.
+ * A matching free hit adds a half-weight RRF term. Free-only hits are appended
+ * after a non-empty quality fusion, capped at 2. When the quality tier is
+ * empty, free results are the page, cut to numResults.
+ */
+
+import { describe, it, expect } from "vitest";
+import type { SearchResult } from "../extensions/types.js";
+import {
+	ALWAYS_INCLUDE_UNIQUE_TAIL,
+	mergeAlwaysInclude,
+	resolveAlwaysInclude,
+	runTieredTargetedCombine,
+} from "../extensions/dispatch.js";
+
+function hit(title: string, url: string): SearchResult {
+	return { title, url, snippet: title };
+}
+
+describe("resolveAlwaysInclude", () => {
+	const active = ["exa", "tavily", "searxng", "langsearch"];
+
+	it("preserves config key order", () => {
+		expect(resolveAlwaysInclude({
+			searxng: { timeoutMs: 3000 },
+			langsearch: { timeoutMs: 5000 },
+		}, active)).toEqual([
+			{ backend: "searxng", timeoutMs: 3000 },
+			{ backend: "langsearch", timeoutMs: 5000 },
+		]);
+	});
+
+	it("rejects a backend that is missing or disabled", () => {
+		expect(() => resolveAlwaysInclude({
+			searxng: { timeoutMs: 3000 },
+		}, ["exa"])).toThrow(/not an enabled backend/);
+	});
+
+	it("rejects a non-positive timeout", () => {
+		expect(() => resolveAlwaysInclude({
+			searxng: { timeoutMs: 0 },
+		}, active)).toThrow(/positive timeoutMs/);
+	});
+});
+
+describe("mergeAlwaysInclude", () => {
+	it("breaks a quality tie toward the URL a free backend also found", () => {
+		const merged = mergeAlwaysInclude({
+			qualityLists: [
+				{ backend: "exa", results: [hit("A", "https://example.com/a"), hit("B", "https://example.com/b")].map((r) => ({ ...r, backend: "exa" })) },
+				{ backend: "tavily", results: [hit("B", "https://example.com/b"), hit("A", "https://example.com/a")].map((r) => ({ ...r, backend: "tavily" })) },
+			],
+			freeLists: [
+				{ backend: "searxng", results: [hit("B confirmed", "https://example.com/b")].map((r) => ({ ...r, backend: "searxng" })) },
+			],
+			numResults: 2,
+		});
+
+		expect(merged.map((r) => r.url)).toEqual([
+			"https://example.com/b",
+			"https://example.com/a",
+		]);
+	});
+
+	it("appends a free-only hit after paid ranks instead of letting it win", () => {
+		const merged = mergeAlwaysInclude({
+			qualityLists: [
+				{
+					backend: "exa",
+					results: [
+						hit("Paid 1", "https://paid.example/rank1"),
+						hit("Paid 2", "https://paid.example/rank2"),
+					].map((r) => ({ ...r, backend: "exa" })),
+				},
+			],
+			freeLists: [
+				{
+					backend: "searxng",
+					results: [
+						hit("SEO", "https://seo.example/noise"),
+						hit("Paid 2 again", "https://paid.example/rank2"),
+					].map((r) => ({ ...r, backend: "searxng" })),
+				},
+			],
+			numResults: 2,
+		});
+
+		// Half-weight confirmation of paid rank 2 can reorder the paid pair.
+		// The free-only URL must still trail both of them.
+		expect(merged.map((r) => r.url)).toEqual([
+			"https://paid.example/rank2",
+			"https://paid.example/rank1",
+			"https://seo.example/noise",
+		]);
+	});
+
+	it("caps the free-only tail at two when the quality tier produced hits", () => {
+		const free = [1, 2, 3, 4, 5].map((n) => hit(`Free ${n}`, `https://free.example/${n}`));
+		const merged = mergeAlwaysInclude({
+			qualityLists: [
+				{ backend: "exa", results: [hit("Paid", "https://paid.example/one")].map((r) => ({ ...r, backend: "exa" })) },
+			],
+			freeLists: [
+				{ backend: "searxng", results: free.map((r) => ({ ...r, backend: "searxng" })) },
+			],
+			numResults: 1,
+		});
+
+		expect(merged).toHaveLength(1 + ALWAYS_INCLUDE_UNIQUE_TAIL);
+		expect(merged[0].url).toBe("https://paid.example/one");
+		expect(merged.slice(1).map((r) => r.url)).toEqual([
+			"https://free.example/1",
+			"https://free.example/2",
+		]);
+	});
+
+	it("returns free results up to numResults when every quality backend is empty", () => {
+		const free = [1, 2, 3, 4, 5].map((n) => hit(`Free ${n}`, `https://free.example/${n}`));
+		const merged = mergeAlwaysInclude({
+			qualityLists: [],
+			freeLists: [
+				{ backend: "searxng", results: free.map((r) => ({ ...r, backend: "searxng" })) },
+			],
+			numResults: 10,
+		});
+
+		expect(merged.map((r) => r.url)).toEqual(free.map((r) => r.url));
+	});
+});
+
+describe("runTieredTargetedCombine", () => {
+	it("does not spend a quality slot on an always-include backend", async () => {
+		const calls: string[] = [];
