{ config, lib, pkgs, ... }:
let
  cfg = config.ponygirls.servicePostgres;
  policy = import ../postgres/policy.nix { inherit lib pkgs cfg; };
in {
  imports = [ ../postgres/options.nix ];
  config = lib.mkMerge [
    { ponygirls.servicePostgres = {
      stateDirectory = lib.mkDefault "/var/lib/ponygirls-postgres-18";
      adminRole = lib.mkDefault "postgres";
    }; }
    (lib.mkIf cfg.enable {
      ponygirls.servicePostgres.manifestFile = policy.manifest;
      assertions = [{ assertion = cfg.adminRole == "postgres"; message = "NixOS shared PostgreSQL administration runs as postgres."; }];
      # Deliberately reuse NixOS's ONE provider, never a hidden second daemon.
      services.postgresql = {
        enable = true;
        package = cfg.package;
        dataDir = "${cfg.stateDirectory}/data";
        settings = (builtins.removeAttrs policy.settings [ "hba_file" "listen_addresses" ]) // {
          # NixOS defines this literal at normal priority (not mkDefault).
          # This intentional policy override preserves exact IPv4 loopback-only
          # binding; authentication remains generated by the stock adapter.
          listen_addresses = lib.mkForce policy.settings.listen_addresses;
        };
        authentication = lib.mkForce policy.hbaText;
      };
      systemd.tmpfiles.rules = [ "d ${cfg.stateDirectory} 0700 postgres postgres -" "d ${cfg.stateDirectory}/socket 0700 postgres postgres -" "d ${cfg.stateDirectory}/backups 0700 postgres postgres -" ];
      # Run before NixOS's automatic initdb; unmarked existing data fails closed.
      systemd.services = { postgresql = { lib, ... }: {
        # Stock custom-dataDir ReadWritePaths mounts BEFORE ExecStartPre. data
        # must remain absent until our no-adoption initializer creates it. The
        # already-private managed root is the exact required writable boundary
        # for ownership marker, socket and data. Transform only stock's child
        # aperture, retaining every separately configured operator aperture.
        options.serviceConfig = lib.mkOption { apply = service:
          let paths = service.ReadWritePaths or [ ];
          in assert lib.assertMsg (builtins.isList paths && lib.all builtins.isString paths)
            "shared PostgreSQL: ReadWritePaths must be a list of strings so additional operator apertures can be preserved";
          service // { ReadWritePaths = lib.unique ([ cfg.stateDirectory ] ++ builtins.filter (path: path != "${cfg.stateDirectory}/data") paths); };
        };
        config.preStart = lib.mkBefore "${policy.init}";
      }; } // lib.mapAttrs' (key: d: lib.nameValuePair "ponygirls-database-${key}" {
        description = "Provision isolated ${key} database/extensions (not app startup)";
        after = [ "postgresql.service" ];
        requires = [ "postgresql.service" ];
        wantedBy = [ "multi-user.target" ];
        serviceConfig = {
          Type = "oneshot";
          User = "postgres";
          ExecStart = policy.provision key;
          RemainAfterExit = true;
          UMask = "0077";
          LoadCredential = lib.optional (!d.createPassword) "database-password:${d.passwordFile}";
          Environment = lib.optional (!d.createPassword) "PONYGIRLS_PASSWORD_FILE=%d/database-password";
          TimeoutStartSec = 180;
        };
      }) cfg.databases;
    })
  ];
}
