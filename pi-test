#!/usr/bin/env bash
# Run pi from this flake (local patches included) with this checkout's
# extensions instead of their deployed copies, without a home-manager switch:
# ./pi-test [pi arguments...]
#
# pi runs in a quick bubblewrap sandbox (yolo is the elaborate one): the
# working directory and pi's agent dir (config, auth, sessions) are writable,
# the checkout is readable, system and Nix paths are read-only, /tmp is
# private, and the network is shared so pi can reach its providers.
#
# The extension list is the one nix/hm/pi.nix deploys. Everything else
# matches the live ~/.pi/agent/settings.json: its packages, its other
# configured extensions, and pi's built-in extensions minus the ones it
# disables. pi runs in the caller's working directory.
set -euo pipefail

root=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
settings=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/settings.json
# pi 1.0.0's built-in extensions (docs/settings.md); --no-extensions drops them.
builtins=(mcp llama.cpp codemode tool-search)

die() {
  echo "pi-test: $*" >&2
  exit 1
}

command -v jq >/dev/null || die "jq is required"

# pi itself comes from this flake's pi-coding-agent package (patches included),
# not from the deployed generation. PI_TEST_PI overrides.
command -v nix >/dev/null || die "nix is required to build pi"
pi_pkg=${PI_TEST_PI:-$(nix build "$root#pi-coding-agent" --no-link --print-out-paths)} || die "cannot build pi-coding-agent"
[[ -x $pi_pkg/bin/pi ]] || die "no pi binary in $pi_pkg (set PI_TEST_PI to override)"

args=(--no-extensions)

# Deployed configuration, except the deployed copies (store paths) of the
# checkout extensions loaded below.
disabled=()
if [[ -f $settings ]]; then
  while IFS= read -r entry; do
    case $entry in
      -builtin:*) disabled+=("${entry#-builtin:}") ;;
      +builtin:* | /nix/store/*) ;;
      *) args+=(-e "$entry") ;;
    esac
  done < <(jq -r '.extensions // [] | .[]' "$settings")
  while IFS= read -r pkg; do
    args+=(-e "$pkg")
  done < <(jq -r '.packages // [] | .[] | if type == "string" then . else .source end' "$settings")
fi
for b in "${builtins[@]}"; do
  [[ " ${disabled[*]} " == *" $b "* ]] || args+=(-e "builtin:$b")
done

# Checkout extensions as pi.nix lists them: "${../pkg/pi-extensions/x}" or "${../pkg/pi-extensions}/x".
mapfile -t rels < <(grep -v '^[[:space:]]*#' "$root/nix/hm/pi.nix" |
  grep -o '"\${\.\./pkg/pi-extensions[^"]*"' |
  sed -E 's|^"\$\{\.\./pkg/pi-extensions([^}]*)\}(.*)"$|\1\2|')
((${#rels[@]} > 0)) || die "no extensions found in nix/hm/pi.nix"
for rel in "${rels[@]}"; do
  path="$root/nix/pkg/pi-extensions$rel"
  [[ -e $path ]] || die "$path (listed in nix/hm/pi.nix) does not exist"
  args+=(-e "$path")
done

# ponygirls-subagents workers import the SDK of the pi that runs them. The deployed
# wrapper sets this once switched.
if [[ -z ${PI_SUBAGENTS_SDK_ROOT:-} ]]; then
  export PI_SUBAGENTS_SDK_ROOT=$pi_pkg/lib/node_modules/pi-monorepo
  [[ -d $PI_SUBAGENTS_SDK_ROOT ]] || die "no SDK in $pi_pkg; set PI_SUBAGENTS_SDK_ROOT"
fi

# ponygirls-bg-tasks needs its supervisor interpreter and task shell; the deployed
# wrapper sets them once switched (wrapper-args.nix). Otherwise build the same
# packages from this flake's pinned nixpkgs.
if [[ -z ${PI_BG_TASKS_PYTHON:-} || -z ${PI_BG_TASKS_SHELL:-} ]]; then
  command -v nix >/dev/null || die "nix is required to resolve ponygirls-bg-tasks executables"
  mapfile -t outs < <(nix build --no-link --print-out-paths --inputs-from "$root" nixpkgs#python3 nixpkgs#bash)
  for out in "${outs[@]}"; do
    [[ -x $out/bin/python3 ]] && export PI_BG_TASKS_PYTHON=${PI_BG_TASKS_PYTHON:-$out/bin/python3}
    [[ -x $out/bin/bash ]] && export PI_BG_TASKS_SHELL=${PI_BG_TASKS_SHELL:-$out/bin/bash}
  done
  [[ -n ${PI_BG_TASKS_PYTHON:-} && -n ${PI_BG_TASKS_SHELL:-} ]] || die "cannot build python3/bash for ponygirls-bg-tasks"
fi

# Quick bubblewrap isolation: local dir and pi's config/auth in, the rest of
# the machine out. bwrap applies mounts in argv order, so writable binds come
# after the read-only system ones.
command -v bwrap >/dev/null || die "bwrap (bubblewrap) is required"
agent_dir=${PI_CODING_AGENT_DIR:-${HOME:?HOME must be set}/.pi/agent}
[[ -d $agent_dir ]] || die "pi agent dir $agent_dir does not exist"
bwrap_args=(
  --unshare-all --share-net --die-with-parent
  --dev /dev --proc /proc --tmpfs /tmp
  --dir /var --symlink /run /var/run
  --ro-bind /nix/store /nix/store
)
for path in /etc /bin /usr /run/current-system /run/wrappers /run/systemd/resolve /run/nscd; do
  [[ -e $path ]] && bwrap_args+=(--ro-bind "$path" "$path")
done
for path in "$HOME/.gitconfig" "$HOME/.config/git"; do
  [[ -e $path ]] && bwrap_args+=(--ro-bind "$path" "$path")
done
bwrap_args+=(--bind "$PWD" "$PWD" --bind "$agent_dir" "$agent_dir")
[[ $root != "$PWD" ]] && bwrap_args+=(--bind "$root" "$root")

exec bwrap "${bwrap_args[@]}" "$pi_pkg/bin/pi" "${args[@]}" "$@"
