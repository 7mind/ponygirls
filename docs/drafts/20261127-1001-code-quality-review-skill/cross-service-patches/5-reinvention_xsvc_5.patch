@@ -0,0 +1,15 @@
+package ponygirls.runtime
+
+import java.nio.file.{Files, Path}
+
+object StaticRoot {
+  /** The regular file under `root` that a rendered URL path names (`index.html` for the empty path), or None when it is
+    * missing, not a regular file, or outside the real root, lexically or through a symbolic link. The root is resolved
+    * on every call; a failing real-path lookup is thrown. No HTTP behaviour: status, headers and caching stay the caller's.
+    */
+  def file(root: Path, rendered: String): Option[Path] = {
+    val base = root.toRealPath(); val relative = rendered.stripPrefix("/")
+    val candidate = base.resolve(if (relative.isEmpty) "index.html" else relative).normalize()
+    if (!candidate.startsWith(base) || !Files.isRegularFile(candidate) || !candidate.toRealPath().startsWith(base)) None else Some(candidate)
+  }
+}
