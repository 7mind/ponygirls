    "start": "bash run.sh",
    "test": "bash ../scripts/test-postgres-scala.sh && bash ../scripts/test-current.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "4.21.2",
    "lossless-json": "4.3.1",
    "pg": "8.23.1",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2"
  }
}
