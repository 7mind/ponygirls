{
  "name": "@haystack/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "bash ../../scripts/backend-sbt.sh haystackServer/assembly",
    "build:characterization": "tsc -p ../characterization/node/tsconfig.json",
