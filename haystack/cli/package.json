{
  "name": "@haystack/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "haystack": "dist/cli/src/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:real": "npm run build && bash tests/run-real.sh"
  },
  "dependencies": {
    "lossless-json": "4.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "@types/ws": "8.18.2"
  }
}
