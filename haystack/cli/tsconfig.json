{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "lossless-json": [
        "./node_modules/lossless-json/lib/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../web/src/lossless-json.ts"
  ]
}
