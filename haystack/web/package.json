{
  "name": "@haystack/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests-browser/run.mjs && node tests-browser/restart.mjs && node tests-browser/quick-preview.mjs"
  },
  "dependencies": {
    "highlight.js": "11.11.1",
    "lossless-json": "4.3.1",
    "lowlight": "3.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.0",
    "vite": "8.3.3"
  }
}
