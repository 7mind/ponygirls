{
  "name": "@chronicle/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --import ./tests/resolve-generated.mjs --test tests/*.test.ts",
    "test:persistent-login": "node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/persistent-login.mjs",
    "test:browser": "node tests-browser/run-all.mjs",
    "test:shell": "node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/shell.mjs",
    "test:search": "node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/search-serp.mjs",
    "test:session": "node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/session.mjs",
    "test:refresh": "node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/refresh-regression.mjs",
    "test:theme": "node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/theme-retry.mjs",
    "test:goal50": "node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/goal50.mjs",
    "test:catalog": "node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/tool-catalog.mjs",
    "test:archive": "node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/archive.mjs",
    "test:access-mcp": "node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/access-mcp.mjs",
    "test:activity": "node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/activity.mjs && node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/activity-maintenance.mjs",
    "test:layout-stability": "node --experimental-transform-types --import ./tests/resolve-generated.mjs tests-browser/layout-stability.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
