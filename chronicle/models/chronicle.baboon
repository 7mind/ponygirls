model chronicle.api
version "1.9.0"

enum SearchMode { Lexical Semantic Hybrid }

enum SourceFormat { Claude Codex Pi }

enum Completion { Quiescent Closed }

enum Scope { Ingest Read Raw }

enum JobState { Queued Running Failed Complete }

data SourceIdentity { collectorNamespace: str discoveryRootId: str format: SourceFormat producerSessionId: str subagentId: opt[str] }

data Metadata { title: str project: opt[str] workdir: opt[str] gitRemote: opt[str] gitBranch: opt[str] gitCommit: opt[str] producer: str model: opt[str] startedAt: opt[str] endedAt: opt[str] tags: lst[str] }

data Message { id: str parentId: opt[str] role: str text: str timestamp: opt[str] recordIndex: i32 }

data RawFile { path: str sha256: str content: str }

root data IngestRequest { requestId: uid source: SourceIdentity expectedRevision: i32 digest: str completion: Completion redacted: bit metadata: Metadata messages: lst[Message] files: lst[RawFile] }

root data IngestReceipt { requestId: uid sessionId: uid revision: i32 jobId: uid }

root data LoginRequest { login: str password: str }

root data LoginResponse { user: UserInfo versions: VersionInfo }

data VersionInfo { current: str minimum: str supported: lst[str] }

data UserInfo { id: str login: str scopes: lst[Scope] }

data SearchFilter { project: opt[str] gitBranch: opt[str] after: opt[str] before: opt[str] tags: lst[str] }

data SearchQuery { query: str mode: SearchMode filter: SearchFilter limit: i32 offset: i32 }

data ContentView { revision: i32 generationId: opt[uid] }

data SessionInfo { view: ContentView id: uid ownerId: str revision: i32 indexedRevision: opt[i32] metadata: Metadata source: SourceIdentity completion: Completion redacted: bit }

data Span { messageId: str start: i32 end: i32 }

data Chunk { id: uid sessionId: uid text: str summary: str tags: lst[str] spans: lst[Span] score: f64 }

data SearchHit { session: SessionInfo chunks: lst[Chunk] score: f64 }

data SearchResult {
  hits: lst[SearchHit]
  total: i32
  countScope: SearchCountScope
  rankingLimit: opt[i32]
}

data SessionResult { session: SessionInfo chunks: lst[Chunk] }

data ChunksResult { chunks: lst[Chunk] total: i32 offset: i32 view: ContentView }

data MessagesResult { messages: lst[Message] total: i32 offset: i32 view: ContentView }

data RawResult { files: lst[RawFile] revision: i32 }

data RelatedResult { sessions: lst[SearchHit] }

data Facet { value: str count: i32 }

data FacetsResult { projects: lst[Facet] branches: lst[Facet] tags: lst[Facet] }

data JobInfo { id: uid sessionId: uid revision: i32 state: JobState attempts: i32 error: opt[str] completedWindows: i32 totalWindows: opt[i32] failureStage: opt[IndexingFailureStage] }

data StatusResult { jobs: lst[JobInfo] total: i32 }

data TokenInfo { id: uid name: str scopes: lst[Scope] createdAt: str revoked: bit }

data TokenResult { token: TokenInfo secret: opt[str] }

data TokensResult { tokens: lst[ListedToken] }

data GroupInfo { id: uid name: str ownerId: str members: lst[str] }

data InviteInfo { id: uid groupId: uid targetId: str expiresAt: str }

data GroupsResult { groups: lst[GroupInfo] invitations: lst[InviteInfo] }

data MutationReceipt { requestId: uid operation: str entityId: opt[uid] }

data Failure { code: str message: str }

root adt Operation {
  data Hello { versions: lst[str] }
  data Ping { nonce: str }
  data Pong { nonce: str }
  data Whoami {}
  data Search { query: SearchQuery }
  data GetSession { sessionId: uid view: opt[ContentView] }
  data GetChunks { sessionId: uid offset: i32 limit: i32 view: opt[ContentView] }
  data GetMessages { sessionId: uid offset: i32 limit: i32 view: opt[ContentView] }
  data SearchSessionMessages { sessionId: uid view: ContentView literal: str cursor: opt[str] limit: i32 }
  data ReadMessageContext { sessionId: uid view: ContentView anchor: Span beforeBytes: i32 afterBytes: i32 }
  data GetRaw { sessionId: uid revision: opt[i32] }
  data Related { sessionId: uid limit: i32 }
  data Facets { filter: SearchFilter }
  data CollectionStatus {}
  data IngestStatus { offset: i32 limit: i32 }
  data RetryJob { jobId: uid }
  data ListTokens {}
  data MintToken { name: str scopes: lst[Scope] }
  data RevokeToken { tokenId: uid }
  data ListGroups {}
  data CreateGroup { name: str }
  data Invite { groupId: uid targetId: str }
  data AcceptInvite { invitationId: uid confirmSharing: bit }
  data RemoveMember { groupId: uid userId: str }
  data LeaveGroup { groupId: uid }
  data DeleteGroup { groupId: uid }
  data Receipt { mutationId: uid }
  data Purge { sessionId: uid }
  data Logout {}
  data Archive { query: ArchiveQuery }
  data ArchiveSearch { query: ArchiveQuery }
  data Activity { query: ActivityQuery }
  data ActivityJobs { query: ActivityJobsQuery }
  data LocateMessage { sessionId: uid view: ContentView messageId: str }
  data PreviewRetryFailed {}
  data ApplyRetryFailed { targetProfile: str selectionHash: str confirm: bit }
  data ExpressionHints { query: ExpressionHintQuery }
  data ModelUsage {}
  data GetPassages { sessionId: uid view: ContentView offset: i32 limit: i32 }
  data GetPassageSpans { sessionId: uid view: ContentView passageId: uid offset: i32 limit: i32 }
  data PreviewOwnerReindex {}
  data ApplyOwnerReindex { targetProfile: str selectionHash: str confirm: bit }
  data GetReindexStatus { requestId: uid }
  data McpTestTools {}
  data StartMcpTest { instanceId: uid runId: uid prompt: str }
  data ReadMcpTest { instanceId: uid runId: uid afterSequence: i64 limit: i32 }
  data CancelMcpTest { instanceId: uid runId: uid }
}

root data ClientEnvelope { requestId: uid operation: Operation }

root adt Result {
  data Hello { versions: VersionInfo user: UserInfo }
  data Pong { nonce: str }
  data Whoami { user: UserInfo }
  data Search { result: SearchResult }
  data Session { result: SessionResult }
  data Chunks { result: ChunksResult }
  data Messages { result: MessagesResult }
  data SessionMessageSearch { result: SessionMessageSearchResult }
  data MessageContext { result: MessageContextResult }
  data Raw { result: RawResult }
  data Related { result: RelatedResult }
  data Facets { result: FacetsResult }
  data CollectionStatus { result: CollectorStatusResult }
  data Status { result: StatusResult }
  data Tokens { result: TokensResult }
  data Token { result: TokenResult }
  data Groups { result: GroupsResult }
  data Mutation { receipt: MutationReceipt }
  data Error { failure: Failure }
  data Ping { nonce: str }
  data Archive { result: ArchiveResult }
  data ArchiveSearch { result: ArchiveSearchResult }
  data Activity { result: ActivityResult }
  data ActivityJobs { result: ActivityJobsResult }
  data LocatedMessage { result: MessageLocation }
  data RetryFailedPreview { result: RetryFailedPlan }
  data RetryFailed { result: RetryFailedResult }
  data ExpressionHints { result: ExpressionHintsResult }
  data ModelUsage { result: ModelUsageResult }
  data Passages { result: PassagesResult }
  data PassageSpans { result: PassageSpansResult }
  data OwnerReindexPreview { result: OwnerReindexPlan }
  data OwnerReindexed { result: OwnerReindexResult }
  data ReindexStatus { result: ReindexStatusResult }
  data McpTestTools { result: McpTestCatalog }
  data McpTestRun { result: McpTestSnapshot }
}

root data ServerEnvelope { requestId: uid result: Result }

enum SearchCountScope { ExactMatches CandidateWindow }

enum TokenSource { Issued StaticConfig }

data ListedToken { info: TokenInfo source: TokenSource }

enum CollectorPhase { Discovering Scanning Uploading Idle Failed }

data CollectorCounters {
  discovered: i32 scanned: i32 waiting: i32 excluded: i32 unchanged: i32
  enqueued: i32 uploaded: i32 uploadFailures: i32 quarantined: i32
  pending: i32 stopped: i32 conflicts: i32 scannedBytes: i64
}

root data CollectorProgressUpdate {
  collectorId: str sequence: i64 runId: uid phase: CollectorPhase startedAt: str
  counters: CollectorCounters totalUploadBytes: i64 uploadedBytes: i64
  currentUploadTotalBytes: opt[i64] error: opt[str]
}

root data CollectorProgressAck { sequence: i64 accepted: bit }

data CollectorStatus { report: CollectorProgressUpdate receivedAt: str stale: bit }

data CollectorStatusResult { collectors: lst[CollectorStatus] }

enum SortDirection { Asc Desc }

enum ArchiveSort {
  LastTimestamp Title Owner Project Branch Producer Format Model Status
  MessageCount Tags
}

enum ArchiveTextScope { ExactLexical BoundedCandidateSets }

data ArchiveQuery {
  expression: str sort: ArchiveSort direction: SortDirection
  cursor: opt[str] limit: i32 preferRelevance: bit
}

data ArchiveRow {
  head: SessionInfo publishedView: opt[ContentView] matchedView: opt[ContentView]
  lastTimestamp: opt[str] messageCount: i32 tags: lst[str] headJob: opt[JobInfo]
  publishedFormat: opt[PassageFormat]
}

data ArchiveResult {
  rows: lst[ArchiveRow] total: i64 nextCursor: opt[str]
  textScope: ArchiveTextScope annChunkLimitPerOperand: opt[i32] relevanceOrdered: bit
}

data MessageLocation { view: ContentView position: i32 total: i32 }

enum ActivityJobScope { Current Historical All }

enum ActivityJobClass {
  Current SupersededRevision ObsoleteProfile SupersededRevisionAndProfile
}

enum ActivityCollectorSort {
  CollectorId Phase Freshness ReceivedAt ArchiveHeads HeadsWithoutTargetJob
  CurrentTotal CurrentQueued CurrentRunning CurrentFailed CurrentComplete
  CurrentActiveRunning CurrentExpiredRunning CurrentUnleasedRunning
  HistoricalTotal HistoricalQueued HistoricalRunning HistoricalFailed HistoricalComplete
  HistoricalActiveRunning HistoricalExpiredRunning HistoricalUnleasedRunning
}

enum ActivityJobSort {
  LastTimestamp Title Collector State Revision Profile Attempts CompletedWindows
  TotalWindows LeaseExpiresAt LeaseState Reason Classification JobId SessionId
}

data JobCounts {
  total: i64 queued: i64 running: i64 failed: i64 complete: i64
  activeRunning: i64 expiredRunning: i64 unleasedRunning: i64
}

data ActivityCollector {
  collectorId: str status: opt[CollectorStatus]
  archiveHeads: i64 headsWithoutTargetJob: i64
  current: JobCounts historical: JobCounts
}

data ActivityQuery { expression: str sort: ActivityCollectorSort direction: SortDirection cursor: opt[str] limit: i32 }

data ActivityResult {
  observedAt: str user: UserInfo archiveHeads: i64 headsWithoutTargetJob: i64
  current: JobCounts historical: JobCounts
  collectors: lst[ActivityCollector] totalCollectors: i64 allCollectors: i64 nextCursor: opt[str]
}

data ActivityJobsQuery {
  collectorId: opt[str] scope: ActivityJobScope expression: str sort: ActivityJobSort direction: SortDirection cursor: opt[str] limit: i32
}

data ActivityJob {
  job: JobInfo profile: str classification: ActivityJobClass
  leaseExpiresAt: opt[str] leaseActive: bit retryable: bit
  collectorId: str session: SessionInfo lastTimestamp: opt[str]
}

data ActivityJobsResult {
  observedAt: str jobs: lst[ActivityJob] total: i64 nextCursor: opt[str]
}

data RetryFailedCounts {
  eligibleCurrentFailed: i64 supersededRevisionFailed: i64 obsoleteProfileFailed: i64
  supersededRevisionAndProfileFailed: i64 unchangedQueued: i64 unchangedRunning: i64 unchangedComplete: i64
}

data RetryFailedPlan { targetProfile: str selectionHash: str counts: RetryFailedCounts }

data RetryFailedResult { requestId: uid targetProfile: str retried: i64 counts: RetryFailedCounts }

adt ExpressionHintTarget {
  data Archive {}
  data ActivityCollectors {}
  data ActivityJobs { scope: ActivityJobScope collectorId: opt[str] }
}

enum ExpressionHintKind { Field Value Operator }

data ExpressionHintQuery { target: ExpressionHintTarget expression: str caretUtf16: i32 limit: i32 }

data ExpressionHint { kind: ExpressionHintKind label: str insertText: str caretOffsetUtf16: i32 }

data ExpressionHintsResult {
  queryHash: str observedAt: str replaceStartUtf16: i32 replaceEndUtf16: i32
  hints: lst[ExpressionHint] truncated: bit
}

enum ModelPurpose { Annotation DocumentEmbedding QueryEmbedding McpTest }

enum ModelRateBasis { ProviderReportedCompletedCalls }

data TokenRateWindow {
  knownTokens: i64 reportedCalls: i64 unknownCalls: i64
  tokensPerSecond: opt[f64] sampleAgeMillis: opt[i64]
}

data ModelUsageSlice {
  purpose: ModelPurpose inFlight: i32 finishedCalls: i64 failedCalls: i64 cancelledCalls: i64 invalidUsageCalls: i64
  input: TokenRateWindow output: opt[TokenRateWindow] reasoningSubset: opt[TokenRateWindow]
}

data IndexingSettings { annotationSessions: i32 embeddingRequests: i32 embeddingBatchSize: i32 }

data ModelUsageResult {
  observedAt: str processStartedAt: str windowStartAt: str windowEndAt: str coveredMillis: i32
  basis: ModelRateBasis settings: IndexingSettings samples: lst[ModelUsageSlice]
}

enum PassageFormat { Unindexed LegacyAnnotations ContiguousProblems ContextAwareProblems }

data PassagePoint { messageId: str messagePosition: i32 byteOffset: i32 }

data PassageInfo {
  id: uid ordinal: i32 summary: str tags: lst[str] start: PassagePoint end: PassagePoint
  sourceBytes: i64 spanCount: i64 pieceCount: i64
}

data PassageSourceSpan { messageId: str messagePosition: i32 start: i32 end: i32 }

data PassagesResult { view: ContentView format: PassageFormat passages: lst[PassageInfo] total: i64 offset: i32 }

data PassageSpansResult { view: ContentView passageId: uid spans: lst[PassageSourceSpan] total: i64 offset: i32 }

data OwnerReindexPlan {
  currentTargetProfile: str targetProfile: str selectionHash: str heads: i64 alreadyCurrent: i64 replacements: i64
}

data OwnerReindexResult {
  requestId: uid targetProfile: str heads: i64 queued: i64 alreadyCurrent: i64 invalidatedClaims: i64
}

data McpToolDefinition { name: str description: str inputSchemaJson: str }

data McpTestLimits {
  maximumRounds: i32 maximumToolCalls: i32 maximumPromptBytes: i32 maximumSourceBytes: i32
  maximumResultBytes: i32 maximumRequestBytes: i32 maximumTraceBytes: i32 maximumEvents: i32
  pageBytes: i32 deadlineSeconds: i32 retentionSeconds: i32
}

data McpTestCatalog {
  instanceId: uid model: str modelRevision: str maximumOutputTokens: i32 reasoningPolicy: str
  limits: McpTestLimits tools: lst[McpToolDefinition]
}

enum McpTestState { Queued Running Complete Failed Cancelled AuthorizationLost Expired }

adt McpTestItem {
  data ToolCall { callId: str tool: str partIndex: i32 partCount: i32 argumentsJsonPart: str }
  data ToolResult { callId: str partIndex: i32 partCount: i32 resultJsonPart: str }
  data Response { partIndex: i32 partCount: i32 textPart: str }
}

data McpTestEvent { sequence: i64 observedAt: str item: McpTestItem }

data McpTestSnapshot {
  instanceId: uid runId: uid state: McpTestState observedAt: str events: lst[McpTestEvent]
  lastSequence: i64 hasMore: bit failure: opt[Failure]
}

data MessageSearchHit { messageId: str position: i32 }

data SessionMessageSearchResult { view: ContentView hits: lst[MessageSearchHit] nextCursor: opt[str] }

enum IndexingFailureStage { Annotation Embedding Publication }

data ReindexStatusResult { requestId: uid targetProfile: str total: i64 complete: i64 superseded: i64 failed: i64 pending: i64 }

data ContextExcerpt { source: PassageSourceSpan role: str text: str }

data MessageContextResult {
  sessionId: uid view: ContentView anchor: PassageSourceSpan excerpts: lst[ContextExcerpt]
  previous: opt[Span] next: opt[Span]
}


enum ArchiveMatchKind { Literal Semantic }
data ArchiveSourceMatch { view: ContentView span: Span kind: ArchiveMatchKind operand: str summary: opt[str] }
data ArchiveSearchEvidence { sessionId: uid matches: lst[ArchiveSourceMatch] }
data ArchiveSearchResult { page: ArchiveResult evidence: lst[ArchiveSearchEvidence] }
