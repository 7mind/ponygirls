{
  "name": "@ponygirls/chronicle-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "chronicle": "dist/cli/src/main.js"
  },
  "scripts": {
    "build": "node scripts/schema.mjs --check && tsc",
    "typecheck": "node scripts/schema.mjs --check && tsc --noEmit",
    "test": "npm run build && node --test dist/cli/test/*.test.js",
    "test:server": "bash scripts/test-server.sh"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
