model ontology.api
version "0.1.0"

root data VersionInfo { current: str minimum: str supported: lst[str] }
root data Failure { code: str message: str }
root data Ack { ok: bit }
enum ActorKind { Human Agent Collector Service Unknown }
data Actor { id: str kind: ActorKind }
data Ref { id: uid revision: i32 }
data ActorRecord { ref: Ref value: Actor }
adt ApplicabilityContext { data Capture { source: Ref } data Subject { ref: Ref } }
adt Applicability {
 data Unresolved { reason: str basis: lst[Ref] context: lst[ApplicabilityContext] }
 data Declared { statement: str basis: lst[Ref] context: lst[ApplicabilityContext] }
 data Captured { source: Ref }
}
enum RequestTransport { Bearer Cookie Internal }
data RequestTrace { hostRequestId: uid operation: str transport: RequestTransport }
adt OriginContext {
 data Unknown { reason: str }
 data ReportedNative { context: CaptureContext }
 data ServiceRequest { trace: RequestTrace }
}
adt OriginContextInput {
 data Unknown { reason: str }
 data ReportedNative { context: CaptureContext }
}
enum InheritanceKind { Fork Import }
adt InheritanceAnchor {
 data ReportedEpoch { source: Ref epoch: uid }
 data ReportedParent { source: Ref epoch: uid }
}
data ReportedInheritance { kind: InheritanceKind sourceScope: str generation: i64 sourceFrontier: i64 coveredFrontier: i64 bindingRefs: lst[Ref] sourceRefs: lst[Ref] anchor: opt[InheritanceAnchor] }
data ContextRecord { origin: OriginContext reportedInherited: lst[ReportedInheritance] }
data ContextRecordInput { origin: OriginContextInput reportedInherited: lst[ReportedInheritance] }
data Provenance { contributor: Actor recorder: Actor input: uid recordedAt: str }
enum InputKind { GraphMutation Capture Curation PresentationPublication Judgment }
root data PresentationPublication { presentationId: uid reservedSourceRef: Ref payloadDigest: str }
data InputReceipt { ref: Ref scope: str generation: i64 kind: InputKind contributor: Actor recorder: Actor submitter: Actor encoding: str content: str digest: str recordedAt: str contributionContext: ContextRecord ingress: RequestTrace }
enum Force { Required Preferred Unresolved }
enum Polarity { Required Prohibited }
enum Execution { Delegated HumanRequired }
enum Modality { Assertion Prediction Assumption ObservationAccount }
enum Correction { Implementation Interpretation IntentChange Mixed Unresolved }
enum Assessment { Unassessed Supported Contradicted Mixed }
enum AssessmentUseDisposition { Applicable Excluded Unresolved }
enum Escalation { NoEscalation HumanRequired Unresolved }
enum ConflictState { Open Resolved }
enum Standing { Active Superseded Withdrawn }
data Acceptance { clauses: lst[str] question: opt[Ref] }

data ReviewResponseLink { presentationId: uid judgmentId: uid presentationSource: Ref payloadDigest: str }
adt SourceDescriptor {
 data PrimaryCapture { eventId: uid sourceNamespace: str captureContext: ContextRecord metadata: CaptureMetadata origin: EventOrigin observation: Observation reviewResponse: opt[ReviewResponseLink] }
 data DerivedPresentation { presentationId: uid generation: i64 payloadDigest: str preparedAt: str preparationTrace: RequestTrace }
}

adt Content {
 data Outcome { text: str acceptance: Acceptance force: Force }
 data Constraint { text: str polarity: Polarity force: Force }
 data Task { text: str acceptance: Acceptance execution: Execution }
 data Statement { text: str modality: Modality }
 data Hypothesis { text: str prediction: str }
 data Defect { text: str observed: str expected: str reproduction: str affected: lst[Ref] correction: Correction }
 data Question { text: str alternatives: lst[str] answer: opt[str] escalation: Escalation }
 data Decision { text: str alternatives: lst[str] rationale: str }
 data Review { text: str findings: lst[str] subjects: lst[Ref] basis: lst[Ref] uncertainty: str assessment: Assessment }
 data Source { text: str context: lst[Ref] rawDigest: str descriptor: SourceDescriptor }
 data Artifact { text: str digest: str mediaType: str locator: str generation: i64 }
 data Conflict { text: str subjects: lst[Ref] status: ConflictState resolution: opt[str] uncertainty: str }
}

enum RelationKind { Quotes Interprets Infers Assumes Supports Challenges Adopts Chooses Delegates Supersedes Withdraws ContributesTo DependsOn Requires Decomposes AssignedTo PlannedOutput Produced Answers Assesses UsesAssessment }
enum Gate { Completion Fulfillment }
enum Consumption { Current Historical }
enum Grouping { All Alternative Navigation }
enum AdoptionOrigin { Interpretation CapturedAction }
adt RelationDetail {
 data Empty {}
 data Dependency { gate: Gate consumption: Consumption event: opt[Ref] applicability: str }
 data PlanRequirement { workContext: str }
 data Decomposition { grouping: Grouping }
 data Delegation { actors: lst[str] operations: lst[str] outcomes: lst[Ref] }
 data Adoption { presentationId: uid origin: AdoptionOrigin response: Ref selection: PresentedSelection }
 data AssessmentUse { requirement: Ref disposition: AssessmentUseDisposition basis: lst[Ref] }
}
data Definition { ref: Ref scope: str applicability: Applicability content: Content standing: Standing basis: lst[Ref] changeReason: opt[str] provenance: Provenance }
data Relation { ref: Ref scope: str applicability: Applicability kind: RelationKind sources: lst[Ref] targets: lst[Ref] detail: RelationDetail why: str standing: Standing provenance: Provenance }
data Binding { ref: Ref scope: str definition: Ref context: lst[Ref] workContext: str provenance: Provenance }
data BindingSelection { ref: Ref scope: str binding: Ref selected: bit reason: str basis: lst[Ref] provenance: Provenance }
enum Phase { Planned Active Blocked Completed Cancelled Open Resolved }
enum Resolution { Fulfilled NotFulfilled Inconclusive }
data GateBasis { references: lst[Ref] selectionWitnesses: lst[Ref] }
data StateEvent { ref: Ref scope: str subject: Ref previous: opt[Ref] phase: Phase result: opt[Resolution] resolution: opt[str] evidence: lst[Ref] uncertainty: str gateBasis: GateBasis provenance: Provenance }

adt Target { data Exact { ref: Ref } data Created { alias: str } }
data AcceptanceInput { clauses: lst[str] question: opt[Target] }
adt ApplicabilityContextInput { data Capture { source: Target } data Subject { ref: Target } }
adt ApplicabilityInput {
 data Unresolved { reason: str basis: lst[Target] context: lst[ApplicabilityContextInput] }
 data Declared { statement: str basis: lst[Target] context: lst[ApplicabilityContextInput] }
}
adt ContentInput {
 data Outcome { text: str acceptance: AcceptanceInput force: Force }
 data Constraint { text: str polarity: Polarity force: Force }
 data Task { text: str acceptance: AcceptanceInput execution: Execution }
 data Statement { text: str modality: Modality }
 data Hypothesis { text: str prediction: str }
 data Defect { text: str observed: str expected: str reproduction: str affected: lst[Target] correction: Correction }
 data Question { text: str alternatives: lst[str] answer: opt[str] escalation: Escalation }
 data Decision { text: str alternatives: lst[str] rationale: str }
 data Review { text: str findings: lst[str] subjects: lst[Target] basis: lst[Target] uncertainty: str assessment: Assessment }
 data Conflict { text: str subjects: lst[Target] status: ConflictState resolution: opt[str] uncertainty: str }
}
adt PresentedSelectionInput {
 data Whole { target: Target }
 data Alternative { target: Target definition: Target index: i32 label: str }
}
adt RelationDetailInput {
 data Empty {}
 data Dependency { gate: Gate consumption: Consumption event: opt[Target] applicability: str }
 data PlanRequirement { workContext: str }
 data Decomposition { grouping: Grouping }
 data Delegation { actors: lst[str] operations: lst[str] outcomes: lst[Target] }
 data Adoption { presentationId: uid origin: AdoptionOrigin response: Target selection: PresentedSelectionInput }
 data AssessmentUse { requirement: Target disposition: AssessmentUseDisposition basis: lst[Target] }
}
adt Operation {
 data Create { alias: str applicability: ApplicabilityInput content: ContentInput basis: lst[Target] }
 data Revise { alias: str ref: Ref applicability: ApplicabilityInput content: ContentInput standing: Standing basis: lst[Target] reason: str }
 data Relate { alias: str applicability: ApplicabilityInput kind: RelationKind sources: lst[Target] targets: lst[Target] detail: RelationDetailInput why: str }
 data ReviseRelation { alias: str ref: Ref applicability: ApplicabilityInput sources: lst[Target] targets: lst[Target] detail: RelationDetailInput why: str standing: Standing }
 data Bind { alias: str definition: Target context: lst[Target] workContext: str }
 data SelectBinding { alias: str binding: Target selected: bit reason: str basis: lst[Target] }
 data State { alias: str subject: Target previous: opt[Ref] phase: Phase result: opt[Resolution] resolution: opt[str] evidence: lst[Target] uncertainty: str }
}
root data ApplyRequest { scope: str requestId: uid expectedGeneration: i64 operations: lst[Operation] contributionContext: opt[ContextRecordInput] }
data AliasRef { alias: str ref: Ref }
root data ApplyResult { scope: str requestId: uid generation: i64 created: lst[AliasRef] replayed: bit }
root data GraphSnapshot { scope: str generation: i64 coveredFrontier: i64 sourceFrontier: i64 definitions: lst[Definition] relations: lst[Relation] bindings: lst[Binding] events: lst[StateEvent] actors: lst[ActorRecord] selections: lst[BindingSelection] }
enum ReadView { Current History BindingContext }
root data ReadRequest { scope: str view: ReadView targets: lst[Ref] cursor: opt[str] limit: i32 }
adt GraphRecord { data Input { value: InputReceipt } data Person { value: ActorRecord } data Node { value: Definition } data Edge { value: Relation } data Contract { value: Binding } data Progress { value: StateEvent } data Selection { value: BindingSelection } }
root data ReadResult { scope: str generation: i64 records: lst[GraphRecord] cursor: opt[str] }
enum DefinitionKind { Outcome Constraint Task Statement Hypothesis Defect Question Decision Review Source Artifact Conflict }
root data FindRequest { scope: str kind: opt[DefinitionKind] query: str cursor: opt[str] limit: i32 }
data SearchHit { ref: Ref kind: str text: str standing: Standing applicability: Applicability }
root data FindResult { scope: str generation: i64 items: lst[SearchHit] cursor: opt[str] }

// Capture is a separate trusted ingress; these actor claims are not graph mutations.
enum EventOrigin { UserMessage WorkerMessage ToolOutput GraphCommand }
enum LineageStatus { Unknown Recorded }
data CaptureContext { sessionId: str rootSessionId: opt[str] parentSessionId: opt[str] lineage: LineageStatus branch: str epoch: uid }
adt Observation {
 data None {}
 data FileVersion { path: str generation: i64 digest: str length: i64 }
 data FileAbsent { path: str generation: i64 }
 data Execution { action: str checker: str contract: opt[Ref] inputs: lst[Ref] outputs: lst[Ref] exitCode: opt[i32] complete: bit }
}
enum SourceRepresentation { Text PiTranscript HostReceipt GraphCommand HumanJudgment }
data CaptureMetadata { sourceId: str parentSourceId: opt[str] observedAt: opt[str] representation: SourceRepresentation omissions: lst[str] exposedDeliveries: lst[uid] }
root data IngestRequest { scope: str requestId: uid eventId: uid occurrenceContext: opt[ContextRecordInput] contributionContext: opt[ContextRecordInput] origin: EventOrigin metadata: CaptureMetadata text: str observation: Observation }
data CapturedEvent { id: uid scope: str sourceNamespace: str frontier: i64 context: ContextRecord origin: EventOrigin metadata: CaptureMetadata text: str observation: Observation reviewResponse: opt[ReviewResponseLink] provenance: Provenance }
root data IngestResult { scope: str requestId: uid eventId: uid sourceNamespace: str source: Ref artifacts: lst[Ref] frontier: i64 replayed: bit }
root data SourceRequest { scope: str after: i64 limit: i32 }
root data SourceResult { scope: str events: lst[CapturedEvent] frontier: i64 nextAfter: opt[i64] }
enum CurationState { Idle Pending Running Failed Stale Interrupted }
enum CurationAttemptState { Claimed InputSealed Running Published Failed Stale Interrupted }
enum CurationAuditStage { RequestPrepared DispatchPossible ResponseObserved }

data ProjectionInstance { targetId: str incarnation: uid }
root data ProjectionStoreIdentity { format: i32 instance: ProjectionInstance }
root data ProjectionCheckpoint { instance: ProjectionInstance scope: str generation: i64 digest: str }

data CoordinatorFence { ownerId: uid epoch: i64 }
root data CoordinatorLease { fence: CoordinatorFence acquiredAt: str renewedAt: str expiresAt: str }
data CurationAdmissionLimits { maxOrdinals: i32 maxAuditBytes: i32 maxInputBytes: i64 maxPins: i32 maxLabelChars: i32 }
root data CurationClaim {
 attemptId: uid scope: str fence: CoordinatorFence baseGeneration: i64 frontier: i64 previousCoveredFrontier: i64
 admissionLimits: CurationAdmissionLimits
 profileId: str profileDigest: str schemaDigest: str graphDigest: str sourceCutDigest: str claimedAt: str deadlineAt: str
}
data CurationRecordPin { ref: Ref digest: str }
data CurationSourcePin { ref: Ref frontier: i64 digest: str }
root data CurationInputManifest {
 attemptId: uid seed: lst[CurationRecordPin] sources: lst[CurationSourcePin]
 encoding: str inputDigest: str inputBytes: i64 sealedAt: str
}
data CurationAuditPayload { encoding: str content: str digest: str bytes: i64 }
root data CurationAuditRecord {
 attemptId: uid scope: str fence: CoordinatorFence ordinal: i32 stage: CurationAuditStage
 requestDigest: str payload: opt[CurationAuditPayload] observedAt: str
}
root data CurationCandidate {
 attemptId: uid inputDigest: str responseOrdinal: i32 responseDigest: str proposal: CurationProposal proposalDigest: str
}
root data CurationPublicationInput {
 claim: CurationClaim manifest: CurationInputManifest responseOrdinal: i32 responseDigest: str
 proposal: CurationProposal proposalDigest: str publishedAt: str
}
data CurationPublicationReceipt { attemptId: uid scope: str input: Ref generation: i64 frontier: i64 coveredFrontier: i64 recordedAt: str }
root data CurationAttempt {
 claim: CurationClaim state: CurationAttemptState inputManifest: opt[CurationInputManifest]
 candidate: opt[CurationCandidate] publication: opt[CurationPublicationReceipt]
 terminalCode: opt[str] auditUncertain: bit finishedAt: opt[str]
}
data CurationAttemptSummary {
 attemptId: uid baseGeneration: i64 frontier: i64 previousCoveredFrontier: i64 state: CurationAttemptState
 inputDigest: opt[str] lastOrdinal: opt[i32] lastStage: opt[CurationAuditStage]
 terminalCode: opt[str] auditUncertain: bit claimedAt: str deadlineAt: str finishedAt: opt[str]
}
root data ScopeRequest { scope: str }
data ScopeSummary { scope: str generation: i64 frontier: i64 coveredFrontier: i64 curation: CurationState failure: opt[str] rdfGeneration: opt[i64] lastPublicationGeneration: opt[i64] attempt: opt[CurationAttemptSummary] }
root data ScopesResult { items: lst[ScopeSummary] }
root data CurationStatus { scope: str generation: i64 frontier: i64 coveredFrontier: i64 state: CurationState failure: opt[str] lastPublicationGeneration: opt[i64] attempt: opt[CurationAttemptSummary] }
root data CurationProposal { expectedGeneration: i64 frontier: i64 operations: lst[Operation] }

data CapsuleLimits { maxRecords: i32 maxPayloadBytes: i32 }
data CapsulePolicyIdentity { id: str digest: str }
data CapsuleCut { generation: i64 frontier: i64 coveredFrontier: i64 lastPublicationGeneration: opt[i64] attempt: opt[CurationAttemptSummary] }
enum CapsulePartition { SelectedWorkContext UnresolvedScopeContext SupportingContext HistoricalContext }
enum CapsuleRole { RecordAccount IntentAccount HumanBasisAccount DerivedAccount Observation Binding Selection Progress Relation SourceBasis Artifact Attribution }
enum CapsuleQualificationCode {
 CoverageLag NoCurationPublication GraphChangedAfterCuration ReportedContextUnknown UnresolvedApplicability
 UnboundIntent StaleBinding StaleWarrant MissingHumanBasis AmbiguousHumanBasis UnresolvedConflict UnresolvedChange HistoricalEvidence
}
data CapsuleQualification { code: CapsuleQualificationCode subjects: lst[Ref] }
data CapsuleManifestEntry { ref: Ref partition: CapsulePartition roles: lst[CapsuleRole] evidence: lst[Ref] }
data CapsuleChange { previous: opt[Ref] current: opt[Ref] account: Ref reason: opt[str] basis: lst[Ref] humanBasis: lst[Ref] }
data CapsuleManifest { entries: lst[CapsuleManifestEntry] changes: lst[CapsuleChange] qualifications: lst[CapsuleQualification] }
root data CapsuleRequest {
 scope: str requestId: uid workContext: str reportedContext: opt[ContextRecordInput] expectedFrontier: i64 previousCapsuleId: opt[uid]
}
data CapsulePayload {
 scope: str workContext: str reportedContext: ContextRecord cut: CapsuleCut previousCapsuleId: opt[uid]
 policy: CapsulePolicyIdentity records: lst[GraphRecord] manifest: CapsuleManifest text: str
}
root data Capsule {
 id: uid requestId: uid owner: Actor payload: CapsulePayload payloadDigest: str limits: CapsuleLimits preparedAt: str preparationTrace: RequestTrace
}
enum DeliveryBoundary { ClientContext ExtensionContext }
data ReportedBoundaryDigest { encoding: str digest: str }
enum DeliveryCutComparison { SameGraphAndCoverage ChangedGraphOrCoverage }
root data DeliveryRequest {
 scope: str requestId: uid capsuleId: uid capsulePayloadDigest: str workContext: str reportedContext: opt[ContextRecordInput]
 boundary: DeliveryBoundary reportedAt: opt[str] reportedBoundaryPayload: opt[ReportedBoundaryDigest]
}
root data DeliveryReceipt {
 id: uid requestId: uid owner: Actor scope: str capsuleId: uid capsulePayloadDigest: str workContext: str reportedContext: ContextRecord
 boundary: DeliveryBoundary reportedAt: opt[str] reportedBoundaryPayload: opt[ReportedBoundaryDigest] receivedAt: str ingress: RequestTrace
 observedCut: CapsuleCut cutComparison: DeliveryCutComparison
}

enum JudgmentKind { Accept RequestCorrection NeedEvidence ReviseIntent }
root data PresentRequest { scope: str targets: lst[Ref] expectedGeneration: i64 }
adt PresentedSelection {
 data Whole { target: Ref }
 data Alternative { target: Ref definition: Ref index: i32 label: str }
}
adt ReviewAction {
 data Review { kind: JudgmentKind }
 data Choose { selection: PresentedSelection }
 data Adopt { target: Ref }
}
data PresentationManifest { choices: lst[PresentedSelection] adoptionTargets: lst[Ref] }
data PresentationPayload { scope: str generation: i64 targets: lst[Ref] records: lst[GraphRecord] sourceRefs: lst[Ref] manifest: PresentationManifest }
root data Presentation { id: uid owner: Actor reservedSourceRef: Ref payload: PresentationPayload payloadDigest: str createdAt: str preparationTrace: RequestTrace }
root data JudgmentRequest { scope: str requestId: uid presentationId: uid action: ReviewAction rationale: str }
data Judgment { id: uid scope: str requestId: uid presentationId: uid action: ReviewAction rationale: str actor: Actor recordedAt: str source: Ref presentationSource: Ref input: Ref }
root data JudgmentsResult { items: lst[Judgment] }
root data LoginRequest { token: str }
enum Capability { Read Mutate Capture Review HostCapture }
root data Identity { actor: Actor scopes: lst[str] capabilities: lst[Capability] }
root data LoginResult { identity: Identity versions: VersionInfo }
