{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": ".cache",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../generated/typescript/GeneratedWirePlan.ts"]
}
