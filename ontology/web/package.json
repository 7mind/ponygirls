{
  "name": "@ontology/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "schemas:compile": "tsc -p ../scripts/tsconfig.schemas.json",
    "test": "npm run schemas:compile && tsc -p tsconfig.fixtures.json && node --test tests/*.test.mjs",
    "test:browser": "tsc -p tsconfig.fixtures.json && node .cache/fixtures/web/tests-browser/run.js && node .cache/fixtures/web/tests-browser/review-reproductions.js"
  },
  "dependencies": {
    "lossless-json": "4.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
